{%- doc -%}
  Small diagonal arrow used on links and buttons.
  @param {string} [direction] - 'diagonal' (default) or 'play'
{%- enddoc -%}
{%- if direction == 'play' -%}
  <svg class="vant-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 2.5v11l9-5.5z"/></svg>
{%- else -%}
  <svg class="vant-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 13 13 3M5 3h8v8"/></svg>
{%- endif -%}
