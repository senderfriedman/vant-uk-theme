{% doc %}
  Shared Vänt UK styles for the custom vant-* sections.
  Render once at the top of each vant section: {% render 'vant-base' %}
{% enddoc %}

{% stylesheet %}
  /* Vänt content width: about 1280px, matching the approved designs (Horizon's narrow width is 1440px). */
  body.page-width-narrow {
    --page-content-width: 80rem;
  }

  @media screen and (min-width: 1200px) {
    body.page-width-narrow {
      --page-margin: max(56px, var(--safe-area-inset-left, 0px), var(--safe-area-inset-right, 0px));
    }
  }

  .vant-section {
    padding-block-start: var(--vant-pt, 72px);
    padding-block-end: var(--vant-pb, 72px);
    color: var(--vant-fg, var(--color-foreground));
  }

  /* Horizon makes .section backgrounds transparent; this selector is more specific so the Vänt band colours show. */
  html .shopify-section .vant-section.section {
    background-color: var(--vant-bg, transparent);
  }

  @media screen and (max-width: 749px) {
    .vant-section {
      padding-block-start: calc(var(--vant-pt, 72px) * 0.66);
      padding-block-end: calc(var(--vant-pb, 72px) * 0.66);
    }
  }

  .vant-section :is(h1, h2, h3, h4) {
    color: var(--vant-heading, #2e2a2b);
    margin: 0;
  }

  .vant-eyebrow {
    display: block;
    font-family: var(--font-subheading--family);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ef2e32;
    margin: 0 0 16px;
  }

  /* Italic text in headings is used to mark the red half of a heading. Brand rule: no italics. */
  .vant-hl em,
  .vant-hl i {
    font-style: normal;
    color: #ef2e32;
  }

  .vant-muted {
    color: #6b6466;
  }

  .vant-small {
    font-size: 13px;
    line-height: 1.5;
  }

  .vant-rte > * {
    margin: 0;
  }

  .vant-rte > * + * {
    margin-top: 0.75em;
  }

  .vant-section-head {
    margin-bottom: 40px;
  }

  .vant-section-head--center {
    text-align: center;
    margin-inline: auto;
    max-width: 720px;
  }

  .vant-section-head p {
    margin: 16px 0 0;
  }

  .vant-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .vant-buttons .button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .vant-arrow {
    width: 12px;
    height: 12px;
    flex: none;
  }

  .vant-text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 4px;
  }

  .vant-scroll-row {
    display: grid;
    grid-auto-flow: column;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  @media screen and (max-width: 749px) {
    .vant-scroll-row {
      -webkit-mask-image: linear-gradient(to right, #000 85%, transparent);
      mask-image: linear-gradient(to right, #000 85%, transparent);
    }
  }

  .vant-scroll-row::-webkit-scrollbar {
    display: none;
  }

  .vant-scroll-row > * {
    scroll-snap-align: start;
  }

  .vant-img-cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vant-placeholder {
    background: #f5f3f1;
    width: 100%;
    height: 100%;
  }

  .vant-placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.25;
  }

  /* ---------- Motion ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .vant-reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s cubic-bezier(0.2, 0.6, 0.2, 1), transform 0.8s cubic-bezier(0.2, 0.6, 0.2, 1);
      transition-delay: var(--vant-delay, 0ms);
    }

    .vant-reveal.vant-in {
      opacity: 1;
      transform: none;
    }

    .vant-reveal--fade {
      transform: none;
    }

    .vant-reveal--zoom {
      transform: scale(1.04);
      transition-duration: 1.2s;
    }

    .vant-reveal--zoom.vant-in {
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    if (window.vantRevealReady) return;
    window.vantRevealReady = true;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const inEditor = window.Shopify && window.Shopify.designMode;

    /* What animates, and how. Groups stagger their children one after another. */
    const SINGLE = [
      ['.vant-section-head', ''],
      ['.vant-vf__media', 'vant-reveal--zoom'],
      ['.vant-vf__content', ''],
      ['.vant-steps__media', 'vant-reveal--fade'],
      ['.vant-steps__content > .vant-eyebrow, .vant-steps__content > h2', ''],
      ['.vant-fm__media', 'vant-reveal--zoom'],
      ['.vant-fm__content > h2, .vant-fm__content > .vant-fm__text', ''],
      ['.vant-band__inner', ''],
      ['.vant-cmp', ''],
      ['.vant-fab__all', 'vant-reveal--fade'],
      ['.vant-buttons', ''],
      ['.vant-faq__contact', 'vant-reveal--fade'],
    ];
    const GROUPS = [
      ['.vant-cat', '.vant-cat__card'],
      ['.vant-size', '.vant-size__card'],
      ['.vant-nf', '.vant-nf__item'],
      ['.vant-steps__list', '.vant-steps__step'],
      ['.vant-sg', '.vant-sg__item'],
      ['.vant-fab__featured', '.vant-fab__swatch'],
      ['.vant-fm__products', '.vant-fm__card'],
      ['.vant-faq__list', '.vant-faq__item'],
      ['.vant-trust', '.vant-trust__item, .vant-trust__logos'],
    ];

    let observer = null;
    if (!reduce && !inEditor && 'IntersectionObserver' in window) {
      observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('vant-in');
            observer.unobserve(entry.target);
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
      );
    }

    const prepare = (el, extra, delay) => {
      if (!observer || el.dataset.vantReveal) return;
      el.dataset.vantReveal = '1';
      /* Leave anything already on screen alone so nothing flickers on load. */
      const r = el.getBoundingClientRect();
      if (r.top < window.innerHeight * 0.92) return;
      el.classList.add('vant-reveal');
      if (extra) el.classList.add(extra);
      if (delay) el.style.setProperty('--vant-delay', delay + 'ms');
      observer.observe(el);
    };

    const init = (root) => {
      if (!observer) return;
      SINGLE.forEach(([sel, extra]) => root.querySelectorAll(sel).forEach((el) => prepare(el, extra, 0)));
      GROUPS.forEach(([parentSel, childSel]) => {
        root.querySelectorAll(parentSel).forEach((parent) => {
          parent.querySelectorAll(childSel).forEach((el, i) => prepare(el, '', Math.min(i, 5) * 90));
        });
      });
    };

    const start = () => init(document);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
  })();
{% endjavascript %}
