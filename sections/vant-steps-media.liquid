{% render 'vant-base' %}
{% render 'vant-video-dialog' %}
<div
  class="section section--page-width vant-section"
  style="--vant-pt: {{ section.settings.padding_top }}px; --vant-pb: {{ section.settings.padding_bottom }}px; --vant-bg: {{ section.settings.background_color }};"
>
  <div class="vant-steps vant-steps--{{ section.settings.layout }}">
    <div class="vant-steps__media">
      {%- if section.settings.video != blank -%}
        <div class="vant-steps__video">
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '960x', class: 'vant-img-cover' }}
          <button type="button" class="vant-steps__pause" aria-pressed="false" data-vant-pause>{{ section.settings.pause_label }}</button>
        </div>
      {%- elsif section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '(min-width: 750px) 70vw, 100vw', loading: 'lazy', class: 'vant-img-cover' }}
        {%- if section.settings.layout == 'stacked' and section.settings.youtube_id != blank -%}
          <button type="button" class="vant-vf__play vant-steps__play" data-vant-video="{{ section.settings.youtube_id | escape }}" aria-label="Play the fitting film">
            <span class="vant-vf__play-icon"><svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M5 3v10l8-5z"/></svg></span>
            {%- if section.settings.play_label != blank -%}<span class="vant-vf__play-label">{{ section.settings.play_label }}</span>{%- endif -%}
          </button>
        {%- endif -%}
      {%- else -%}
        <div class="vant-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>
    <div class="vant-steps__content">
      {%- if section.settings.eyebrow != blank -%}<p class="vant-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="vant-hl">{{ section.settings.heading }}</h2>{%- endif -%}
      <ol class="vant-steps__list">
        {%- for block in section.blocks -%}
          <li class="vant-steps__step" {{ block.shopify_attributes }}>
            <span class="vant-steps__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div>
              <h3 class="vant-steps__title">{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}<div class="vant-steps__text vant-rte">{{ block.settings.text }}</div>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
      <div class="vant-buttons">
        {%- if section.settings.youtube_id != blank and section.settings.film_label != blank -%}
          <button type="button" class="button" data-vant-video="{{ section.settings.youtube_id | escape }}">{{ section.settings.film_label }} {% render 'vant-arrow', direction: 'play' %}</button>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="vant-text-link" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }} {% render 'vant-arrow' %}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .vant-steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 70px;
    align-items: center;
  }

  .vant-steps__media {
    aspect-ratio: 4 / 3;
    background: #fff;
    overflow: hidden;
  }

  .vant-steps__video {
    position: relative;
    height: 100%;
  }

  .vant-steps__video video {
    object-fit: contain;
    background: #fff;
  }

  .vant-steps__pause {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    background: #fff;
    border: 1px solid #2e2a2b;
    color: #2e2a2b;
    font-size: 13px;
    padding: 10px 18px;
    min-height: 44px;
    cursor: pointer;
  }

  .vant-steps__list {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }

  .vant-steps__step {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    padding: 20px 0;
    border-bottom: 1px solid #dcd8d5;
  }

  .vant-steps__num {
    color: #ef2e32;
    font-size: 17px;
  }

  .vant-steps__title {
    font-size: 19px;
    font-weight: 400;
  }

  .vant-steps__text {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.6;
    color: #6b6466;
  }

  .vant-steps .vant-buttons {
    align-items: center;
    gap: 24px;
  }

  /* Stacked: heading, wide picture with play button, steps in a row */
  .vant-steps--stacked {
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    max-width: 1040px;
    margin-inline: auto;
  }

  .vant-steps--stacked .vant-steps__content {
    display: contents;
  }

  .vant-steps--stacked .vant-steps__content > .vant-eyebrow,
  .vant-steps--stacked .vant-steps__content > h2 {
    order: -2;
    text-align: center;
    margin-bottom: 0;
  }

  .vant-steps--stacked .vant-steps__media {
    order: -1;
    position: relative;
    aspect-ratio: 16 / 8;
  }

  .vant-steps--stacked .vant-steps__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
  }

  .vant-steps--stacked .vant-steps__step {
    border-bottom: 0;
    border-top: 1px solid #dcd8d5;
    padding-top: 18px;
    grid-template-columns: 36px minmax(0, 1fr);
  }

  .vant-steps--stacked .vant-buttons {
    justify-content: center;
    margin-top: 8px;
  }

  @media screen and (max-width: 749px) {
    .vant-steps--stacked .vant-steps__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .vant-steps--stacked .vant-steps__media {
      aspect-ratio: 4 / 3;
    }
  }

  @media screen and (max-width: 749px) {
    .vant-steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .vant-steps__content {
      order: -1;
    }

    .vant-steps .vant-buttons .button {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vant-steps__video video {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', (event) => {
    const btn = event.target.closest('[data-vant-pause]');
    if (!btn) return;
    const video = btn.parentElement.querySelector('video');
    if (!video) return;
    if (video.paused) {
      video.play();
      btn.setAttribute('aria-pressed', 'false');
      btn.textContent = btn.dataset.pauseText || 'Pause animation';
    } else {
      btn.dataset.pauseText = btn.dataset.pauseText || btn.textContent;
      video.pause();
      btn.setAttribute('aria-pressed', 'true');
      btn.textContent = 'Play animation';
    }
  });

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.vant-steps__video video').forEach((v) => v.pause());
  }
{% endjavascript %}

{% schema %}
{
