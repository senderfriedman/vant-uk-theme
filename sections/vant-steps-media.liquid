          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vänt steps with media",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Fix the brackets",
            "text": "<p>Screw the aluminium brackets to your wall. No wall plugs needed on plasterboard; pre-drill 5mm holes on brick or concrete.</p>"
