      "default": "Pause animation"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Meet SimpleMount"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "How it fixes to your wall"
    },
    {
      "type": "text",
      "id": "youtube_id",
      "label": "Film YouTube ID",
      "default": "g2ugde7Zth8"
    },
    {
      "type": "text",
      "id": "film_label",
      "label": "Film button",
      "default": "Watch the fitting film"
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "Label on the picture's play button (stacked layout)",
      "default": "Watch the video"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Text link (optional)"
