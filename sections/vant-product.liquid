{% render 'vant-base' %}
<script type="application/ld+json">
  {{ product | structured_data }}
</script>
{%- liquid
  assign s = section.settings
  assign is_layout = false
  if s.mode == 'layout'
    assign is_layout = true
  endif

  comment
    Starting variant: ?variant= wins, then the "start on colour" setting, then the first in stock.
  endcomment
  assign current = product.selected_variant
  if current == blank and s.default_colour != blank
    assign wanted = s.default_colour | downcase
    for v in product.variants
      assign vt = v.title | downcase
      if v.available and vt contains wanted
        assign current = v
        break
      endif
    endfor
  endif
  if current == blank
    assign current = product.selected_or_first_available_variant
  endif

  comment

    Fabric (option 1) and colour (option 2) positions

  endcomment
  assign fabric_index = 0
  assign colour_index = 1
  for o in product.options_with_values
    assign on = o.name | downcase
    if on == 'color' or on == 'colour'
      assign colour_index = forloop.index0
    elsif on == 'fabric' or on == 'material'
      assign fabric_index = forloop.index0
    endif
  endfor
  if product.options.size < 2
    assign colour_index = -1
  endif

  comment

    Fabric order follows Theme settings > Vänt > Fabric display names

  endcomment
  assign fabric_values = product.options_with_values[fabric_index].values
  assign option1_label = product.options_with_values[fabric_index].name | replace: 'Color', 'Colour'
  if option1_label contains ' Colour'
    assign option1_label = option1_label | remove: ' Colour'
  endif
  assign option2_label = 'Colour'
  if colour_index >= 0
    assign option2_label = product.options_with_values[colour_index].name | replace: 'Color', 'Colour'
    if option2_label contains ' Colour'
      assign option2_label = option2_label | remove: ' Colour'
    endif
  endif
  assign order_lines = settings.vant_fabric_names | newline_to_br | split: '<br />'
  assign fabrics_sorted = ''
  for line in order_lines
    assign from = line | split: '|' | first | strip | downcase
    for fv in fabric_values
      assign fvd = fv | downcase
      if fvd == from
        assign fabrics_sorted = fabrics_sorted | append: fv | append: '§'
      endif
    endfor
  endfor
  for fv in fabric_values
    assign key = fv | append: '§'
    unless fabrics_sorted contains key
      assign fabrics_sorted = fabrics_sorted | append: key
    endunless
  endfor
  assign fabrics = fabrics_sorted | split: '§'

  assign swatch_handle = settings.vant_swatch_collection_handle | default: 'order-swatches'
  assign swatch_collection = collections[swatch_handle]

  comment

    Layout facts

  endcomment
  if is_layout
    capture facts
      render 'vant-layout-facts', product: product
    endcapture
    assign f = facts | split: '|'
    capture group
      render 'vant-bed-group', product: product
    endcapture
    assign g = group | split: '|'
  endif

  assign display_title = s.title | default: product.title
  if is_layout and f[0] != blank
    assign display_title = f[0] | append: ' × ' | append: f[1] | append: 'cm ' | append: s.layout_title_suffix | strip
  endif

  assign unit = ''
  if s.show_quantity
    assign unit = s.unit_label
  endif
-%}

<div
  class="section section--page-width vant-section vant-pdp"
  style="--vant-pt: {{ s.padding_top }}px; --vant-pb: {{ s.padding_bottom }}px;"
  data-vant-product
  data-section-id="{{ section.id }}"
>
  {%- if s.show_breadcrumb -%}
    <nav class="vant-crumbs vant-pdp__crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="{{ routes.root_url }}">Home</a></li>
        {%- if s.crumb_1_label != blank -%}
          <li><a href="{{ s.crumb_1_link | default: '#' }}">{{ s.crumb_1_label }}</a></li>
        {%- endif -%}
        {%- if s.crumb_2_label != blank -%}
          <li><a href="{{ s.crumb_2_link | default: '#' }}">{{ s.crumb_2_label }}</a></li>
        {%- endif -%}
        {%- if is_layout and g[1] != blank -%}
          <li aria-current="page">{{ g[1] }}</li>
        {%- else -%}
          <li aria-current="page">{{ s.crumb_current | default: display_title }}</li>
        {%- endif -%}
      </ol>
    </nav>
  {%- endif -%}

  <div class="vant-pdp__grid">
    {%- comment -%} Gallery {%- endcomment -%}
    {%- liquid
      assign diagram_caption = ''
      if is_layout
        if f[7] != blank
          capture diagram
            assign wl = f[0] | append: 'cm'
            assign hl = f[1] | append: 'cm'
            render 'vant-panel-diagram', cols_76: f[8], cols_91: f[9], rows: f[7], width_label: wl, height_label: hl
          endcapture
          assign across = f[8] | times: 1 | plus: f[9]
          assign diagram_caption = across | append: ' across × ' | append: f[7] | append: ' high = ' | append: f[4] | append: ' panels'
        endif
      else
        assign pack_w = product.title | split: ' - ' | last | downcase | split: 'x' | first | remove: 'cm' | strip
        if pack_w == '76' or pack_w == '91'
          assign c76 = 0
          assign c91 = 0
          if pack_w == '76'
            assign c76 = 1
          else
            assign c91 = 1
          endif
          capture diagram
            assign wl = pack_w | append: 'cm'
            render 'vant-panel-diagram', cols_76: c76, cols_91: c91, rows: 1, width_label: wl, height_label: '30cm'
          endcapture
          assign diagram_caption = s.diagram_caption | replace: '[width]', pack_w
        endif
      endif
    -%}
    <div class="vant-pdp__gallery">
      {%- assign main_img = current.featured_image | default: product.featured_image -%}
      <figure class="vant-pdp__main">
        <div class="vant-pdp__frame">
          {%- if main_img != blank -%}
            {{
              main_img
              | image_url: width: 1600
              | image_tag:
                widths: '600, 900, 1200, 1600',
                sizes: '(min-width: 990px) 55vw, 100vw',
                fetchpriority: 'high',
                class: 'vant-pdp__main-img',
                alt: product.title
            }}
          {%- else -%}
            <div class="vant-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
          <div class="vant-pdp__alt" data-vant-alt hidden></div>
        </div>
        <figcaption class="vant-pdp__caption" data-vant-caption></figcaption>
        <p class="vant-pdp__note" data-vant-gallery-note hidden></p>
      </figure>
      <div class="vant-pdp__thumbs" role="list" data-vant-thumbs>
        {%- comment -%} Thumb 1: the selected colour. Thumb 2: fabric close-up (from the swatch). Then fixed extra images. {%- endcomment -%}
        <button type="button" class="vant-pdp__thumb is-active" data-vant-thumb="variant" aria-label="Show the selected colour">
          {%- if main_img != blank -%}{{ main_img | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
        </button>
        {%- if s.companion_product != blank -%}
          <button type="button" class="vant-pdp__thumb" data-vant-thumb="companion" data-caption="{{ s.companion_caption | escape }}" aria-label="{{ s.companion_caption | default: 'Show another view' | escape }}" hidden></button>
        {%- endif -%}
        <button type="button" class="vant-pdp__thumb" data-vant-thumb="closeup" aria-label="Show a fabric close-up" hidden></button>
        {%- if diagram != blank -%}
          <button
            type="button"
            class="vant-pdp__thumb vant-pdp__thumb--svg"
            data-vant-thumb="diagram"
            data-caption="{{ diagram_caption | escape }}"
            data-note="{% unless is_layout %}{{ s.diagram_note | escape }}{% endunless %}"
            aria-label="Show the size plan"
          >
            {{ diagram }}
          </button>
          <template data-vant-diagram>{{ diagram }}</template>
        {%- endif -%}
        {%- if s.gallery_video != blank -%}
          <button type="button" class="vant-pdp__thumb vant-pdp__thumb--video" data-vant-thumb="video" data-caption="{{ s.gallery_video_caption | escape }}" aria-label="Play: {{ s.gallery_video_caption | default: 'video' | escape }}">
            {%- if s.gallery_video.preview_image != blank -%}
              {{ s.gallery_video.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            {%- endif -%}
            <span class="vant-pdp__thumb-play" aria-hidden="true"><svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor"><path d="M5 3v10l8-5z"/></svg></span>
          </button>
          <template data-vant-video>{{ s.gallery_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x' }}</template>
        {%- endif -%}
        {%- for i in (1..4) -%}
          {%- assign key = 'extra_image_' | append: i -%}
          {%- assign cap_key = 'extra_caption_' | append: i -%}
          {%- assign extra = s[key] -%}
          {%- if extra != blank -%}
            <button
              type="button"
              class="vant-pdp__thumb"
              data-vant-thumb="extra"
              data-src="{{ extra | image_url: width: 1600 }}"
              data-srcset="{{ extra | image_url: width: 600 }} 600w, {{ extra | image_url: width: 900 }} 900w, {{ extra | image_url: width: 1200 }} 1200w, {{ extra | image_url: width: 1600 }} 1600w"
              data-caption="{{ s[cap_key] | escape }}"
              aria-label="{{ s[cap_key] | default: 'Show image' | escape }}"
            >
              {{ extra | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Buy box {%- endcomment -%}
    <div class="vant-pdp__info">
      {%- if is_layout and g[1] != blank -%}
        <a class="vant-pdp__back" href="{{ s.layouts_collection.url | default: '/collections/pre-configured-layouts' }}?bed={{ g[1] | handleize }}">
          <span aria-hidden="true">←</span> All {{ g[1] }} layouts
        </a>
      {%- elsif s.eyebrow != blank -%}
        <p class="vant-eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}

      <h1 class="vant-pdp__title">{{ display_title }}</h1>

      {%- if is_layout -%}
        {%- if f[3] != blank or f[0] != blank -%}
          <ul class="vant-chips">
            {%- if f[3] != blank -%}<li>{{ f[3] }}</li>{%- endif -%}
          </ul>
        {%- endif -%}
        <p class="vant-pdp__sub">
          {{ f[2] }}
          {%- if g[2] != blank -%}
            {%- assign first_letter = g[2] | slice: 0 | downcase -%}
            {%- assign rest_note = g[2] | slice: 1, 300 | remove_last: '.' %} · {{ first_letter }}{{ rest_note }}
          {%- endif -%}
        </p>
      {%- endif -%}

      <p class="vant-pdp__price">
        <span data-vant-price>{{ current.price | money_without_trailing_zeros }}</span>
        {%- if unit != blank %} <span class="vant-pdp__unit">per {{ unit }}</span>{% endif -%}
      </p>

      {%- if s.intro != blank -%}<p class="vant-pdp__intro">{{ s.intro }}</p>{%- endif -%}

      {%- comment -%} Size switcher: links to the sibling products (e.g. 76cm and 91cm packs) {%- endcomment -%}
      {%- liquid
        assign in_sizes = false
        for sp in s.size_products
          if sp.id == product.id
            assign in_sizes = true
          endif
        endfor
      -%}
      {%- if s.size_products.count > 1 and in_sizes -%}
        {%- assign notes = s.size_notes | newline_to_br | split: '<br />' -%}
        {%- assign size_labels = s.size_labels | newline_to_br | split: '<br />' -%}
        <div class="vant-pdp__group">
          <p class="vant-pdp__label">{{ s.size_heading }}</p>
          <div class="vant-pdp__sizes">
            {%- for sp in s.size_products -%}
              {%- liquid
                assign size_label = sp.title | split: ' - ' | last | downcase | split: 'x' | first | strip | append: ' ' | append: s.size_suffix
                assign custom_label = size_labels[forloop.index0] | strip
                if custom_label != blank
                  assign size_label = custom_label
                endif
                assign note = notes[forloop.index0] | strip
              -%}
              {%- liquid
                assign size_url = sp.url
                if template.suffix != blank and sp.template_suffix != template.suffix
                  assign size_url = size_url | append: '?view=' | append: template.suffix
                endif
              -%}
              <a
                class="vant-pdp__size{% if sp.id == product.id %} is-active{% endif %}"
                href="{{ size_url }}"
                data-vant-size-link
                {% if sp.id == product.id %}aria-current="true"{% endif %}
              >
                <span class="vant-pdp__size-name">{{ size_label | strip }}</span>
                {%- if note != blank -%}<span class="vant-pdp__size-note">{{ note }}</span>{%- endif -%}
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} Fabric tabs {%- endcomment -%}
      {%- if fabrics.size > 1 -%}
        <div class="vant-pdp__group">
          <p class="vant-pdp__label">{{ option1_label }}</p>
          <div class="vant-pdp__fabrics" role="group" aria-label="{{ option1_label | escape }}">
            {%- for fv in fabrics -%}
              {%- capture fname -%}{% render 'vant-fabric-name', name: fv %}{%- endcapture -%}
              <button
                type="button"
                class="vant-pdp__fabric"
                data-vant-fabric="{{ fv | escape }}"
                aria-pressed="{% if current.options[fabric_index] == fv %}true{% else %}false{% endif %}"
              >
                {{ fname }}
              </button>
            {%- endfor -%}
          </div>
          {%- assign note_lines = settings.vant_fabric_notes | newline_to_br | split: '<br />' -%}
          {%- for fv in fabrics -%}
            {%- capture fname -%}{% render 'vant-fabric-name', name: fv %}{%- endcapture -%}
            {%- liquid
              assign fkey = fname | strip | downcase
              assign fnote = ''
              for line in note_lines
                assign parts = line | split: '|'
                assign k = parts[0] | strip | downcase
                if k == fkey and parts[1] != blank
                  assign fnote = parts[1] | strip
                  break
                endif
              endfor
            -%}
            {%- if fnote != blank -%}
              <p class="vant-pdp__fabric-note" data-vant-fabric-note="{{ fv | escape }}"{% unless current.options[fabric_index] == fv %} hidden{% endunless %}>{{ fnote }}</p>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Colour circles, one per variant; JS shows the ones for the chosen fabric {%- endcomment -%}
      {%- if colour_index >= 0 -%}
        <div class="vant-pdp__group">
          <p class="vant-pdp__label">{{ option2_label }}: <span data-vant-colour-label>{{ current.options[colour_index] }}</span></p>
          <div class="vant-pdp__colours" role="group" aria-label="{{ option2_label | escape }}">
            {%- for v in product.variants -%}
              {%- liquid
                assign vf = v.options[fabric_index]
                assign vc = v.options[colour_index]
                capture vfd
                  render 'vant-fabric-name', name: vf
                endcapture
                assign want_a = vf | append: ' ' | append: vc | handleize
                assign want_b = vfd | append: ' ' | append: vc | handleize
                assign want_c = vc | handleize
                assign sw = nil
                for sp in swatch_collection.products
                  assign th = sp.title | handleize
                  if th == want_a or th == want_b
                    assign sw = sp
                    break
                  endif
                endfor
                if sw == nil
                  for sp in swatch_collection.products
                    assign th = sp.title | handleize
                    assign tail = '-' | append: want_c
                    if th contains tail
                      assign sw = sp
                      break
                    endif
                  endfor
                endif
                assign sw_img = sw.featured_image
                if sw_img == blank
                  assign sw_img = v.featured_image
                endif
              -%}
              <button
                type="button"
                class="vant-pdp__colour{% unless v.available %} is-out{% endunless %}"
                data-vant-colour="{{ vc | escape }}"
                data-fabric="{{ vf | escape }}"
                aria-pressed="{% if v.id == current.id %}true{% else %}false{% endif %}"
                aria-label="{{ vc | escape }}{% unless v.available %} (sold out){% endunless %}"
                title="{{ vc | escape }}"
                {% if vf != current.options[fabric_index] %}hidden{% endif %}
              >
                {%- if sw_img != blank -%}
                  <span class="vant-pdp__dot" style="background-image: url('{{ sw_img | image_url: width: 160, height: 160, crop: 'center' }}');"></span>
                {%- else -%}
                  <span class="vant-pdp__dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
          {%- if s.swatch_link_label != blank -%}
            <a class="vant-pdp__swatch-link" href="{{ swatch_collection.url | default: '/collections/order-swatches' }}" data-vant-swatch-link>
              {%- render 'vant-icon', icon: 'swatch' -%}
              <span>{{ s.swatch_link_label }}</span>
              {%- render 'vant-arrow' -%}
            </a>
          {%- endif -%}
          {%- if s.swatch_add_label != blank -%}
            <p class="vant-pdp__swatch-add-row">
              <button type="button" class="vant-pdp__swatch-add" data-vant-swatch-add hidden>
                {{ s.swatch_add_label }}
              </button>
              <span class="vant-pdp__swatch-added" data-vant-swatch-added role="status" hidden>{{ s.swatch_added_text }}</span>
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- liquid
        assign facts_have_boxes = false
        if s.facts contains '[boxes]'
          assign facts_have_boxes = true
        endif
        assign box_text = ''
        if is_layout and f[4] != blank
          assign b76 = f[5] | times: 1
          assign b91 = f[6] | times: 1
          if b76 > 0
            assign box_text = b76 | append: ' box'
            if b76 > 1
              assign box_text = box_text | append: 'es'
            endif
            assign box_text = box_text | append: ' of 76cm'
          endif
          if b91 > 0
            if box_text != ''
              assign box_text = box_text | append: ' and '
            endif
            assign box_text = box_text | append: b91 | append: ' box'
            if b91 > 1
              assign box_text = box_text | append: 'es'
            endif
            assign box_text = box_text | append: ' of 91cm'
          endif
        endif
      -%}
      {%- if is_layout and f[4] != blank and s.includes_text != blank and facts_have_boxes == false -%}
        {%- liquid
          assign inc = s.includes_text | replace: '[boxes]', box_text | replace: '[panels]', f[4]
        -%}
        <p class="vant-pdp__includes">{% render 'vant-icon', icon: 'layers' %}<span>{{ inc }}</span></p>
      {%- endif -%}

      <form method="post" action="{{ routes.cart_add_url }}" class="vant-pdp__form" data-vant-form>
        <input type="hidden" name="id" value="{{ current.id }}" data-vant-id>
        {%- if s.show_quantity -%}
          <div class="vant-pdp__qty-row">
            <div class="vant-qty">
              <button type="button" data-vant-qty="-1" aria-label="One less">−</button>
              <input type="number" name="quantity" value="1" min="1" max="50" inputmode="numeric" aria-label="Quantity" data-vant-qty-input>
              <button type="button" data-vant-qty="1" aria-label="One more">+</button>
            </div>
            <span class="vant-pdp__unit">{{ unit }}</span>
            {%- if s.help_link_label != blank -%}
              <button type="button" class="vant-text-link vant-pdp__help" data-vant-help-open>{{ s.help_link_label }}</button>
            {%- endif -%}
          </div>
          <p class="vant-pdp__total">Total: <span data-vant-total>{{ current.price | money_without_trailing_zeros }} for 1 {{ unit }}</span></p>
        {%- else -%}
          <input type="hidden" name="quantity" value="1" data-vant-qty-input>
        {%- endif -%}

        <button type="submit" class="button vant-pdp__add" data-vant-add {% unless current.available %}disabled{% endunless %}>
          <span data-vant-add-label>{% if current.available %}{{ s.add_label }}{% else %}Sold out{% endif %}</span>
        </button>
        <p class="vant-pdp__error" role="alert" data-vant-error hidden></p>
      </form>

      {%- if s.facts != blank -%}
        {%- liquid
          if is_layout
            assign fact_width = f[0]
            assign fact_size = f[0] | append: ' × ' | append: f[1] | append: 'cm'
          else
            assign fact_width = product.title | split: ' - ' | last | downcase | split: 'x' | first | remove: 'cm' | strip
            assign fact_size = ''
          endif
          assign fact_lines = s.facts | newline_to_br | split: '<br />'
        -%}
        <dl class="vant-pdp__facts">
          {%- for line in fact_lines -%}
            {%- liquid
              assign parts = line | split: '|'
              assign flabel = parts[0] | strip
              assign fvalue = parts[1] | strip
              assign fvalue = fvalue | replace: '[size]', fact_size | replace: '[width]', fact_width | replace: '[panels]', f[4] | replace: '[boxes]', box_text
            -%}
            {%- if flabel != blank and fvalue != blank -%}
              <div class="vant-pdp__fact"><dt>{{ flabel }}</dt><dd>{{ fvalue }}</dd></div>
            {%- endif -%}
          {%- endfor -%}
        </dl>
      {%- elsif s.tick_1 != blank or s.tick_2 != blank -%}
        <ul class="vant-ticks">
          {%- if s.tick_1 != blank -%}<li>{{ s.tick_1 }}</li>{%- endif -%}
          {%- if s.tick_2 != blank -%}<li>{{ s.tick_2 }}</li>{%- endif -%}
        </ul>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="vant-pdp__details">
          {%- for block in section.blocks -%}
            {%- liquid
              assign body = block.settings.text
              if is_layout
                assign width_val = f[0]
              else
                assign width_val = product.title | split: ' - ' | last | downcase | split: 'x' | first | remove: 'cm' | strip
              endif
              assign body = body | replace: '[width]', width_val
              if is_layout and f[0] != blank
                assign size_txt = f[0] | append: ' × ' | append: f[1] | append: 'cm'
                assign body = body | replace: '[size]', size_txt | replace: '[panels]', f[4]
              endif
            -%}
            <details class="vant-pdp__detail" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title }}</summary>
              <div class="vant-rte">{{ body }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Mobile sticky bar: shows once the main button scrolls out of view {%- endcomment -%}
  <div class="vant-pdp__bar" data-vant-bar aria-hidden="true">
    <div class="vant-pdp__bar-text">
      <span data-vant-bar-name></span>
      <span class="vant-pdp__bar-price" data-vant-bar-price></span>
    </div>
    <button type="button" class="button" data-vant-bar-add tabindex="-1">{{ s.add_label }}</button>
  </div>

  {%- if s.show_quantity and s.help_link_label != blank -%}
    <dialog class="vant-dialog" data-vant-help>
      <div class="vant-dialog__inner">
        <button type="button" class="vant-dialog__close" data-vant-help-close aria-label="Close">×</button>
        <h2 class="vant-dialog__title">{{ s.help_heading }}</h2>
        <div class="vant-rte">{{ s.help_text }}</div>
        {%- if s.help_button_label != blank -%}
          <a class="button button-secondary" href="{{ s.help_button_link | default: '#' }}">{{ s.help_button_label }} {% render 'vant-arrow' %}</a>
        {%- endif -%}
      </div>
    </dialog>
  {%- endif -%}

  <script type="application/json" data-vant-product-json>
    {
      "fabricIndex": {{ fabric_index }},
      "colourIndex": {{ colour_index }},
      "unit": {{ unit | json }},
      "currency": {{ cart.currency.iso_code | json }},
      "addLabel": {{ s.add_label | json }},
      "swatchUrl": {{ swatch_collection.url | default: '/collections/order-swatches' | json }},
      "fabricNames": {
        {%- for fv in fabrics -%}
          {%- capture fname -%}{% render 'vant-fabric-name', name: fv %}{%- endcapture -%}
          {{ fv | json }}: {{ fname | strip | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      },
      "variants": [
        {%- for v in product.variants -%}
          {%- liquid
            assign vf = v.options[fabric_index]
            assign vc = v.options[colour_index]
            capture vfd
              render 'vant-fabric-name', name: vf
            endcapture
            assign want_a = vf | append: ' ' | append: vc | handleize
            assign want_b = vfd | append: ' ' | append: vc | handleize
            assign want_c = vc | handleize
            assign sw = nil
            for sp in swatch_collection.products
              assign th = sp.title | handleize
              if th == want_a or th == want_b
                assign sw = sp
                break
              endif
            endfor
            if sw == nil
              for sp in swatch_collection.products
                assign th = sp.title | handleize
                assign tail = '-' | append: want_c
                if th contains tail
                  assign sw = sp
                  break
                endif
              endfor
            endif
            assign vi = v.featured_image | default: product.featured_image
            assign ci = nil
            if s.companion_product != blank
              for cv in s.companion_product.variants
                capture cvfd
                  render 'vant-fabric-name', name: cv.option1
                endcapture
                assign ckey = cvfd | append: ' ' | append: cv.option2 | handleize
                if ckey == want_b
                  assign ci = cv.featured_image
                  break
                endif
              endfor
              if ci == nil
                for cv in s.companion_product.variants
                  if cv.option2 == vc and cv.featured_image != blank
                    assign ci = cv.featured_image
                    break
                  endif
                endfor
              endif
            endif
          -%}
          {%- if ci != nil and ci != blank -%}
            {%- liquid
              assign c6 = ci | image_url: width: 600
              assign c9 = ci | image_url: width: 900
              assign c12 = ci | image_url: width: 1200
              assign c16 = ci | image_url: width: 1600
              assign csrcset = c6 | append: ' 600w, ' | append: c9 | append: ' 900w, ' | append: c12 | append: ' 1200w, ' | append: c16 | append: ' 1600w'
            -%}
          {%- endif -%}
          {
            "id": {{ v.id }},
            "available": {{ v.available | json }},
            "price": {{ v.price }},
            "fabric": {{ vf | json }},
            "colour": {{ vc | json }},
            "key": {{ want_b | json }},
            {%- if vi != blank -%}
              "img": {{ vi | image_url: width: 1600 | json }},
              {%- liquid
                assign u6 = vi | image_url: width: 600
                assign u9 = vi | image_url: width: 900
                assign u12 = vi | image_url: width: 1200
                assign u16 = vi | image_url: width: 1600
                assign srcset = u6 | append: ' 600w, ' | append: u9 | append: ' 900w, ' | append: u12 | append: ' 1200w, ' | append: u16 | append: ' 1600w'
              -%}
              "srcset": {{ srcset | json }},
              "thumb": {{ vi | image_url: width: 200 | json }},
            {%- endif -%}
            {%- if sw != nil and sw.featured_image != blank -%}
              "swatchHandle": {{ sw.handle | json }},
              {%- if sw.variants.first.available -%}"swatchVariant": {{ sw.variants.first.id | json }},{%- endif -%}
              "closeup": {{ sw.featured_image | image_url: width: 1600, height: 1200, crop: 'center' | json }},
              "closeupThumb": {{ sw.featured_image | image_url: width: 200, height: 200, crop: 'center' | json }},
            {%- endif -%}
            {%- if ci != nil and ci != blank -%}
              "companion": {{ c16 | json }},
              "companionSrcset": {{ csrcset | json }},
              "companionThumb": {{ ci | image_url: width: 200 | json }},
            {%- endif -%}
            "title": {{ v.title | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</div>

<script type="module" src="{{ 'vant-cart.js' | asset_url }}"></script>
<script type="module" src="{{ 'vant-product.js' | asset_url }}"></script>

{% stylesheet %}
  .vant-pdp__crumbs ol {
    padding-top: 0;
  }

  .vant-pdp__grid > * {
    min-width: 0;
  }

  .vant-pdp__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }

  .vant-pdp__gallery {
    position: sticky;
    top: calc(var(--header-height, 80px) + 24px);
  }

  .vant-pdp__main {
    margin: 0;
  }

  .vant-pdp__frame {
    aspect-ratio: 4 / 3;
    background: #f5f3f1;
    overflow: hidden;
  }

  .vant-pdp__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: opacity 0.25s ease;
  }

  .vant-pdp__frame img.is-cover {
    object-fit: cover;
  }

  .vant-pdp__frame img.is-loading {
    opacity: 0.4;
  }

  .vant-pdp__caption {
    font-size: 12px;
    color: #6b6466;
    text-align: center;
    padding-top: 10px;
    min-height: 1.6em;
  }

  .vant-pdp__thumbs {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  .vant-pdp__thumb {
    width: 72px;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid #dcd8d5;
    background: #f5f3f1 center / cover no-repeat;
    cursor: pointer;
    overflow: hidden;
  }

  .vant-pdp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vant-pdp__thumb.is-active {
    border: 2px solid #2e2a2b;
  }

  .vant-pdp__back {
    display: inline-flex;
    gap: 8px;
    font-size: 14px;
    color: inherit;
    text-underline-offset: 3px;
    margin-bottom: 14px;
  }

  .vant-pdp__title {
    margin: 6px 0 12px;
    font-size: clamp(30px, 3.2vw, 40px);
    line-height: 1.1;
  }

  .vant-pdp__sub {
    font-size: 14px;
    color: #6b6466;
    margin: 0 0 18px;
  }

  .vant-pdp__price {
    font-size: 28px;
    color: #2e2a2b;
    margin: 0 0 10px;
  }

  .vant-pdp__unit {
    font-size: 15px;
    color: #6b6466;
  }

  .vant-pdp__intro {
    font-size: 15px;
    margin: 0 0 8px;
  }

  .vant-pdp__group {
    margin-top: 22px;
  }

  .vant-pdp__label {
    font-size: 14px;
    color: #2e2a2b;
    margin: 0 0 10px;
  }

  .vant-pdp__sizes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 8px;
  }

  .vant-pdp__size {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid #dcd8d5;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .vant-pdp__size:hover {
    border-color: #2e2a2b;
  }

  .vant-pdp__size.is-active {
    border: 2px solid #2e2a2b;
    padding: 13px 15px;
  }

  .vant-pdp__size-name {
    font-size: 16px;
    color: #2e2a2b;
  }

  .vant-pdp__size-note {
    font-size: 12px;
    color: #6b6466;
  }

  .vant-pdp__fabric-note {
    margin: 10px 0 0;
    font-size: 13px;
    color: #5c5657;
  }

  .vant-pdp__fabric-note[hidden] {
    display: none;
  }

  .vant-pdp__fabrics {
    display: flex;
    gap: 2px 18px;
    border-bottom: 1px solid #dcd8d5;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .vant-pdp__fabrics::-webkit-scrollbar {
    display: none;
  }

  .vant-pdp__fabric {
    flex: none;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 10px 0 12px;
    margin-bottom: -1px;
    font: inherit;
    font-size: 14px;
    color: #6b6466;
    cursor: pointer;
    white-space: nowrap;
  }

  .vant-pdp__fabric:hover {
    color: #2e2a2b;
  }

  .vant-pdp__fabric[aria-pressed='true'] {
    color: #2e2a2b;
    border-bottom-color: #ef2e32;
  }

  .vant-pdp__colours {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .vant-pdp__colour {
    width: 44px;
    height: 44px;
    padding: 3px;
    border-radius: 50%;
    border: 1px solid transparent;
    background: none;
    cursor: pointer;
    position: relative;
  }

  .vant-pdp__colour[hidden] {
    display: none;
  }

  .vant-pdp__colour[aria-pressed='true'] {
    border: 2px solid #2e2a2b;
    padding: 2px;
  }

  .vant-pdp__colour:hover .vant-pdp__dot {
    transform: scale(1.06);
  }

  .vant-pdp__dot {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #dcd8d5 center / cover no-repeat;
    box-shadow: inset 0 0 0 1px rgb(46 42 43 / 0.12);
    transition: transform 0.2s ease;
  }

  .vant-pdp__colour.is-out .vant-pdp__dot {
    opacity: 0.45;
  }

  .vant-pdp__colour.is-out::after {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
    top: 50%;
    border-top: 1px solid #2e2a2b;
    transform: rotate(-45deg);
  }

  .vant-pdp__swatch-add-row {
    margin: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
  }

  .vant-pdp__swatch-add {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font: inherit;
    font-size: 14px;
    color: #2e2a2b;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .vant-pdp__swatch-add[hidden],
  .vant-pdp__swatch-added[hidden] {
    display: none;
  }

  .vant-pdp__swatch-add.is-busy {
    opacity: 0.5;
    pointer-events: none;
  }

  .vant-pdp__swatch-added {
    font-size: 14px;
    color: #2e7d4f;
  }

  .vant-pdp__swatch-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-size: 15px;
    font-weight: 500;
    color: #e0262b;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .vant-pdp__swatch-link:hover {
    color: #c81e23;
  }

  .vant-pdp__swatch-link svg {
    width: 20px;
    height: 20px;
    flex: none;
  }

  .vant-pdp__swatch-link .vant-arrow,
  .vant-pdp__swatch-link span + svg {
    width: 12px;
    height: 12px;
  }

  .vant-pdp__frame {
    position: relative;
  }

  .vant-pdp__alt {
    position: absolute;
    inset: 0;
    background: #f5f3f1;
    display: grid;
    place-items: center;
  }

  .vant-pdp__alt[hidden] {
    display: none;
  }

  .vant-pdp__alt svg {
    width: 100%;
    height: 100%;
    padding: 4% 6%;
  }

  .vant-pdp__alt video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #fff;
  }

  .vant-pdp__note {
    font-size: 12px;
    color: #6b6466;
    text-align: center;
    margin: 4px auto 0;
    max-width: 440px;
  }

  .vant-pdp__thumb--svg {
    background: #f5f3f1;
  }

  .vant-pdp__thumb--svg svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .vant-pdp__thumb--svg text {
    display: none;
  }

  .vant-pdp__thumb--video {
    position: relative;
    background: #fff;
  }

  .vant-pdp__thumb-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #2e2a2b;
    color: #fff;
    display: grid;
    place-items: center;
  }

  .vant-pdp__includes {
    display: flex;
    gap: 12px;
    align-items: center;
    margin: 24px 0 0;
    padding: 14px 16px;
    background: #f5f3f1;
    border: 1px solid #dcd8d5;
    font-size: 14px;
  }

  .vant-pdp__includes svg {
    width: 22px;
    height: 22px;
    flex: none;
  }

  .vant-pdp__form {
    margin-top: 22px;
  }

  .vant-pdp__qty-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .vant-qty {
    display: inline-grid;
    grid-template-columns: 44px 48px 44px;
    border: 1px solid #dcd8d5;
    height: 46px;
  }

  .vant-qty button {
    background: none;
    border: 0;
    font-size: 18px;
    cursor: pointer;
    color: #2e2a2b;
  }

  .vant-qty input {
    border: 0;
    text-align: center;
    font: inherit;
    font-size: 15px;
    width: 100%;
    -moz-appearance: textfield;
    appearance: textfield;
    background: none;
  }

  .vant-qty input::-webkit-outer-spin-button,
  .vant-qty input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .vant-pdp__help {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  .vant-pdp__total {
    font-size: 20px;
    color: #2e2a2b;
    margin: 22px 0 14px;
  }

  .vant-pdp__add {
    width: 100%;
    justify-content: center;
    min-height: 54px;
    font-size: 16px;
    margin-top: 6px;
  }

  .vant-pdp__add[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .vant-pdp__add.is-busy {
    opacity: 0.75;
    pointer-events: none;
  }

  .vant-pdp__error {
    color: #c81e23;
    font-size: 14px;
    margin: 10px 0 0;
  }

  .vant-ticks {
    list-style: none;
    margin: 20px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid #dcd8d5;
    display: grid;
    gap: 8px;
  }

  .vant-ticks li {
    font-size: 13px;
    padding-left: 26px;
    position: relative;
  }

  .vant-ticks li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 3px;
    width: 12px;
    height: 7px;
    border-left: 1.5px solid #2e2a2b;
    border-bottom: 1.5px solid #2e2a2b;
    transform: rotate(-45deg);
  }

  .vant-pdp__facts {
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 14px;
  }

  .vant-pdp__fact {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 12px;
  }

  .vant-pdp__fact dt {
    font-weight: 500;
    color: #2e2a2b;
  }

  .vant-pdp__fact dd {
    margin: 0;
    color: #5c5657;
  }

  .vant-pdp__details {
    margin-top: 22px;
    border-top: 1px solid #dcd8d5;
  }

  .vant-pdp__detail {
    border-bottom: 1px solid #dcd8d5;
  }

  .vant-pdp__detail summary {
    list-style: none;
    cursor: pointer;
    padding: 16px 28px 16px 0;
    font-size: 15px;
    color: #2e2a2b;
    position: relative;
  }

  .vant-pdp__detail summary::-webkit-details-marker {
    display: none;
  }

  .vant-pdp__detail summary::after {
    content: '+';
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 20px;
    font-weight: 300;
  }

  .vant-pdp__detail[open] summary::after {
    content: '−';
  }

  .vant-pdp__detail .vant-rte {
    padding: 0 0 18px;
    font-size: 14px;
  }

  .vant-pdp__bar {
    display: none;
  }

  .vant-dialog {
    border: 0;
    padding: 0;
    max-width: min(520px, calc(100vw - 32px));
    width: 100%;
  }

  .vant-dialog::backdrop {
    background: rgb(46 42 43 / 0.55);
  }

  .vant-dialog__inner {
    padding: 36px 32px 32px;
    position: relative;
  }

  .vant-dialog__title {
    font-size: 26px;
    margin: 0 0 14px;
  }

  .vant-dialog__inner .button {
    margin-top: 18px;
  }

  .vant-dialog__close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 40px;
    height: 40px;
    border: 0;
    background: none;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    color: #2e2a2b;
  }

  @media screen and (max-width: 989px) {
    .vant-pdp__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .vant-pdp__gallery {
      position: static;
    }
  }

  @media screen and (max-width: 749px) {
    .vant-pdp__thumbs {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .vant-pdp__thumb {
      flex: none;
      width: 60px;
    }

    .vant-pdp__bar {
      display: flex;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 20;
      gap: 12px;
      align-items: center;
      justify-content: space-between;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
      background: #fff;
      box-shadow: 0 -1px 0 #dcd8d5, 0 -8px 24px rgb(46 42 43 / 0.08);
      transform: translateY(110%);
      transition: transform 0.25s ease;
    }

    .vant-pdp__bar.is-visible {
      transform: none;
    }

    .vant-pdp__bar-text {
      display: grid;
      font-size: 13px;
      line-height: 1.35;
      min-width: 0;
    }

    .vant-pdp__bar-text span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .vant-pdp__bar-price {
      color: #2e2a2b;
      font-size: 15px;
    }

    .vant-pdp__bar .button {
      flex: none;
      --button-padding-block: 12px;
      --button-padding-inline: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vänt product",
  "tag": "section",
  "class": "vant-product-section",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Page type",
      "options": [
        { "value": "pack", "label": "Pack of panels" },
        { "value": "layout", "label": "Ready-made layout" }
      ],
      "default": "pack",
      "info": "Ready-made layout: the title, height tag, bed size and box count come from the product's title, handle and tags."
    },
    { "type": "text", "id": "default_colour", "label": "Start on this colour", "default": "Velvet / Sand Storm", "info": "Used when the link doesn't pick a colour. Matches the variant name." },
    { "type": "header", "content": "Breadcrumb" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "crumb_1_label", "label": "Crumb 1", "default": "Headboard walls" },
    { "type": "url", "id": "crumb_1_link", "label": "Crumb 1 link" },
    { "type": "text", "id": "crumb_2_label", "label": "Crumb 2 (optional)" },
    { "type": "url", "id": "crumb_2_link", "label": "Crumb 2 link" },
    { "type": "text", "id": "crumb_current", "label": "Current page name", "info": "Pack pages only. Layout pages show the bed size." },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Upholstered wall panels" },
    { "type": "text", "id": "title", "label": "Title", "info": "Pack pages: overrides the product title. Layout pages build the title from the size." },
    { "type": "text", "id": "layout_title_suffix", "label": "Layout title ending", "default": "headboard wall", "info": "Layout pages: '152 × 120cm' + this." },
    { "type": "text", "id": "intro", "label": "Intro", "default": "4 panels plus the brackets and all fixings. Arrange them your way." },
    { "type": "header", "content": "Panel size" },
    { "type": "product_list", "id": "size_products", "label": "Size products", "limit": 4, "info": "Pick the 76cm and 91cm packs to show a size switch. Hidden with fewer than 2." },
    { "type": "text", "id": "size_heading", "label": "Size label", "default": "Panel size" },
    { "type": "text", "id": "size_suffix", "label": "After the size", "default": "wide" },
    { "type": "textarea", "id": "size_labels", "label": "Size names (optional)", "info": "One line per product, e.g. Double, King, Super King. Leave empty to use the size from the product title." },
    { "type": "textarea", "id": "size_notes", "label": "Size notes", "default": "Popular for Double & King beds\nPopular for Single & Super King beds", "info": "One line per size product, in the same order." },
    { "type": "header", "content": "Buying" },
    { "type": "text", "id": "swatch_link_label", "label": "Swatch link", "default": "Not sure? Order a swatch" },
