{% render 'vant-base' %}
<div
  class="section section--page-width vant-section{% if section.settings.hide_on_phones %} vant-trust-hide-phone{% endif %}"
  style="--vant-pt: {{ section.settings.padding_top }}px; --vant-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="vant-trust vant-scroll-row">
    {%- assign logos = section.blocks | where: 'type', 'logo' -%}
    {%- if logos.size > 0 -%}
      <div class="vant-trust__logos">
        {%- if section.settings.logos_label != blank -%}
          <span class="vant-trust__label">{{ section.settings.logos_label }}</span>
        {%- endif -%}
        {%- for block in logos -%}
          <span class="vant-trust__logo" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: block.settings.name, style: 'max-height: 26px; width: auto;' }}
            {%- else -%}
              <span class="vant-trust__logo-text">{{ block.settings.name }}</span>
            {%- endif -%}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign items = section.blocks | where: 'type', 'item' -%}
    {%- if items.size > 0 -%}<div class="vant-trust__items">{%- endif -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'item' -%}
        {%- if block.settings.link != blank -%}
          <a class="vant-trust__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="vant-trust__item" {{ block.shopify_attributes }}>
        {%- endif -%}
          {% render 'vant-icon', icon: block.settings.icon %}
          <span>{{ block.settings.text }}</span>
        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if items.size > 0 -%}</div>{%- endif -%}
  </div>
</div>

{% stylesheet %}
  .vant-trust-section {
    border-bottom: 1px solid #dcd8d5;
  }

  .vant-trust {
    grid-auto-columns: max-content;
    align-items: center;
    gap: 40px;
    justify-content: space-between;
  }

  /* Desktop and tablet: the benefits sit in the same row as the logos */
  .vant-trust__items {
    display: contents;
  }

  .vant-trust__logos {
    display: flex;
    align-items: center;
    gap: 22px;
    color: #6b6466;
  }

  .vant-trust__label {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .vant-trust__logo {
    display: inline-flex;
    align-items: center;
    filter: grayscale(1);
    opacity: 0.7;
  }

  .vant-trust__logo-text {
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .vant-trust__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    font-size: 14px;
    color: #4a4446;
    text-decoration: none;
    max-width: 170px;
  }

  a.vant-trust__item span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (min-width: 750px) and (max-width: 1099px) {
    .vant-trust.vant-scroll-row {
      -webkit-mask-image: linear-gradient(to right, #000 85%, transparent);
      mask-image: linear-gradient(to right, #000 85%, transparent);
    }
  }

  @media screen and (min-width: 1100px) {
    .vant-trust {
      overflow: visible;
    }
  }

  /* Phones: "As seen on" stays put on its own line, and the benefits are a separate bar below it.
     Nothing scrolls sideways, so every point is visible without swiping. */
  @media screen and (max-width: 749px) {
    .vant-trust.vant-scroll-row {
      display: block;
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .vant-trust__logos {
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px 20px;
    }

    .vant-trust__label {
      flex-basis: 100%;
      text-align: center;
    }

    .vant-trust__items {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 16px;
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid #dcd8d5;
    }

    .vant-trust__item {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      max-width: none;
      font-size: 13px;
      line-height: 1.35;
    }

    .vant-trust__item svg {
      flex: none;
    }

    /* An odd one out at the end takes the full width */
    .vant-trust__item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    /* "Hide on phones": used where the same points are shown inside another section */
    .vant-section.vant-trust-hide-phone {
      display: none;
    }

    .vant-trust-section:has(.vant-trust-hide-phone) {
      border-bottom: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vänt trust strip",
  "tag": "section",
  "class": "vant-trust-section",
  "settings": [
    { "type": "text", "id": "logos_label", "label": "Logos label", "default": "As seen on" },
    { "type": "checkbox", "id": "hide_on_phones", "label": "Hide on phones", "info": "Use when the same points are shown inside another section on phones.", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 28 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press logo",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "HGTV" },
        { "type": "image_picker", "id": "image", "label": "Logo image", "info": "Shown in grey. Use the official logo, with permission." }
      ]
    },
    {
      "type": "item",
      "name": "Trust point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "delivery", "label": "Delivery van" },
            { "value": "swatch", "label": "Swatches" },
            { "value": "bracket", "label": "Bracket" },
            { "value": "returns", "label": "Returns" },
            { "value": "warranty", "label": "Warranty" },
            { "value": "phone", "label": "Phone" }
          ],
          "default": "delivery"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Free GB delivery" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vänt trust strip",
      "blocks": [
        { "type": "logo", "settings": { "name": "HGTV" } },
        { "type": "logo", "settings": { "name": "Netflix · Queer Eye" } },
        { "type": "logo", "settings": { "name": "DIY Network" } },
        { "type": "item", "settings": { "icon": "delivery", "text": "Free GB delivery" } },
        { "type": "item", "settings": { "icon": "swatch", "text": "Fabric swatches" } },
        { "type": "item", "settings": { "icon": "bracket", "text": "Secure brackets, won’t sag or slide" } },
        { "type": "item", "settings": { "icon": "returns", "text": "14-day returns" } },
        { "type": "item", "settings": { "icon": "warranty", "text": "1-year warranty" } }
      ]
    }
  ]
}
{% endschema %}
