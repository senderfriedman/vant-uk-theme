{% render 'vant-base' %}
{%- liquid
  assign s = section.settings
  assign source = s.collection
  if source == blank
    assign source = collection
  endif
  assign sorted = source.products | sort: 'price'
  assign default_key = s.default_group | handleize
  assign lines = settings.vant_bed_groups | newline_to_br | split: '<br />'
-%}
<div
  class="section section--page-width vant-section vant-lg"
  style="--vant-pt: {{ s.padding_top }}px; --vant-pb: {{ s.padding_bottom }}px;"
  data-vant-layout-grid
  data-default="{{ default_key }}"
>
  <div>
    {%- if s.show_breadcrumb -%}
      <nav class="vant-crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="{{ routes.root_url }}">Home</a></li>
          {%- if s.crumb_parent_label != blank -%}
            <li><a href="{{ s.crumb_parent_link | default: '#' }}">{{ s.crumb_parent_label }}</a></li>
          {%- endif -%}
          <li aria-current="page">{{ s.crumb_label | default: source.title }}</li>
        </ol>
      </nav>
    {%- endif -%}

    <header class="vant-lg__head">
      <h1 class="vant-lg__title vant-hl">{{ s.heading | default: source.title }}</h1>
      {%- if s.intro != blank -%}<p class="vant-lg__intro">{{ s.intro }}</p>{%- endif -%}
    </header>

    <div class="vant-lg__tabs-wrap">
      <div class="vant-lg__tabs" role="tablist" aria-label="Bed size">
        {%- for line in lines -%}
          {%- liquid
            assign parts = line | split: '|'
            assign tag = parts[0] | strip
            assign name = parts[1] | strip
            if tag == blank or name == blank
              continue
            endif
            assign count = 0
            for p in sorted
              if p.tags contains tag
                assign count = count | plus: 1
              endif
            endfor
            if count == 0
              continue
            endif
            assign key = name | handleize
          -%}
          <button
            type="button"
            role="tab"
            class="vant-lg__tab"
            id="vant-tab-{{ section.id }}-{{ key }}"
            data-key="{{ key }}"
            aria-selected="{% if key == default_key %}true{% else %}false{% endif %}"
            aria-controls="vant-panel-{{ section.id }}"
          >
            {{ name }} <span class="vant-lg__count">({{ count }})</span>
          </button>
        {%- endfor -%}
      </div>
    </div>

    <div class="vant-lg__notes">
      {%- for line in lines -%}
        {%- liquid
          assign parts = line | split: '|'
          assign name = parts[1] | strip
          assign note = parts[2] | strip
          if name == blank
            continue
          endif
          assign key = name | handleize
        -%}
        {%- if note != blank -%}
          <p class="vant-lg__note" data-key="{{ key }}" {% unless key == default_key %}hidden{% endunless %}>{{ note }}</p>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="vant-lg__grid" id="vant-panel-{{ section.id }}" role="tabpanel">
      {%- for p in sorted -%}
        {%- liquid
          assign keys = ''
          for line in lines
            assign parts = line | split: '|'
            assign tag = parts[0] | strip
            assign name = parts[1] | strip
            if tag != blank and p.tags contains tag
              assign hk = name | handleize
              assign keys = keys | append: ' ' | append: hk
            endif
          endfor
          assign keys = keys | strip
          assign show = false
          if keys contains default_key or default_key == blank
            assign show = true
          endif
          assign popular = false
          for pp in s.popular_products
            if pp.id == p.id
              assign popular = true
            endif
          endfor
        -%}
        <div class="vant-lg__item" data-keys="{{ keys }}" {% unless show %}hidden{% endunless %}>
          {% render 'vant-layout-card',
            product: p,
            popular: popular,
            badge: s.popular_label,
            wider_label: s.wider_label,
            sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 92vw'
          %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (() => {
    const init = (root) => {
      if (!root || root.dataset.ready) return;
      root.dataset.ready = '1';
      const tabs = Array.from(root.querySelectorAll('.vant-lg__tab'));
      const items = Array.from(root.querySelectorAll('.vant-lg__item'));
      const notes = Array.from(root.querySelectorAll('.vant-lg__note'));
      const select = (key, { focus = false, push = false } = {}) => {
        const tab = tabs.find((t) => t.dataset.key === key) || tabs[0];
        if (!tab) return;
        key = tab.dataset.key;
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
        });
        items.forEach((item) => {
          item.hidden = !(' ' + item.dataset.keys + ' ').includes(' ' + key + ' ');
        });
        notes.forEach((n) => (n.hidden = n.dataset.key !== key));
        if (focus) tab.focus();
        tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        if (push) {
          try {
            const url = new URL(window.location.href);
            url.searchParams.set('bed', key);
            history.replaceState(history.state, '', url.pathname + url.search + url.hash);
          } catch (e) {}
        }
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab.dataset.key, { push: true }));
        tab.addEventListener('keydown', (e) => {
          const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          e.preventDefault();
          const next = tabs[(i + step + tabs.length) % tabs.length];
          select(next.dataset.key, { focus: true, push: true });
        });
      });
      const wanted = new URLSearchParams(window.location.search).get('bed');
      select(wanted || root.dataset.default);
    };
    document.querySelectorAll('[data-vant-layout-grid]').forEach(init);
    document.addEventListener('shopify:section:load', (e) => init(e.target.querySelector('[data-vant-layout-grid]')));
  })();
</script>

{% stylesheet %}
  .vant-lg .vant-crumbs ol {
    padding-top: 0;
  }

  .vant-lg__head {
    padding: 6px 0 24px;
  }

  .vant-lg__title {
    margin: 0 0 12px;
    font-size: clamp(32px, 4vw, 48px);
  }

  .vant-lg__intro {
    margin: 0;
    max-width: 640px;
  }

  .vant-lg__tabs-wrap {
    border-top: 1px solid #dcd8d5;
    border-bottom: 1px solid #dcd8d5;
    margin: 0 calc(-1 * var(--page-margin, 0px));
    padding: 0 var(--page-margin, 0px);
  }

  .vant-lg__tabs {
    display: flex;
    gap: 36px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .vant-lg__tabs::-webkit-scrollbar {
    display: none;
  }

  .vant-lg__tab {
    flex: none;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 18px 0 16px;
    font: inherit;
    font-size: 15px;
    color: #6b6466;
    cursor: pointer;
    white-space: nowrap;
  }

  .vant-lg__tab:hover {
    color: #2e2a2b;
  }

  .vant-lg__tab[aria-selected='true'] {
    color: #2e2a2b;
    border-bottom-color: #ef2e32;
  }

  .vant-lg__count {
    font-size: 12px;
  }

  .vant-lg__notes {
    min-height: 1px;
  }

  .vant-lg__note {
    font-size: 13px;
    color: #6b6466;
    margin: 14px 0 0;
  }

  .vant-lg__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .vant-lg__item[hidden] {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .vant-lg__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
  }

  @media screen and (max-width: 749px) {
    .vant-lg__tabs {
      gap: 24px;
      -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
      mask-image: linear-gradient(90deg, #000 85%, transparent);
      padding-right: 40px;
    }

    .vant-lg__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vänt layouts by bed size",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Tabs come from Theme settings > Vänt > Bed size groups. Layouts are sorted by price." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Uses the page's collection if empty." },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "crumb_parent_label", "label": "Middle crumb", "default": "Headboard walls" },
    { "type": "url", "id": "crumb_parent_link", "label": "Middle crumb link" },
    { "type": "text", "id": "crumb_label", "label": "Current page name", "default": "Ready-made layouts" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Ready-made headboard walls" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Pre-planned layouts for your bed or wall. Every layout comes in all 26 colours." },
    { "type": "text", "id": "default_group", "label": "Tab open first", "default": "Double & King", "info": "The group name, as in the Bed size groups setting." },
    { "type": "product_list", "id": "popular_products", "label": "Most popular layouts", "limit": 6 },
    { "type": "text", "id": "popular_label", "label": "Badge", "default": "Most popular" },
    { "type": "text", "id": "wider_label", "label": "Wider-than-bed tag", "default": "Wider than bed" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Vänt layouts by bed size" }]
}
{% endschema %}
