{% render 'vant-base' %}
<div
  class="section section--page-width vant-section"
  style="--vant-pt: {{ section.settings.padding_top }}px; --vant-pb: {{ section.settings.padding_bottom }}px;"
>
  <div>
    {%- if section.settings.heading != blank -%}
      <div class="vant-section-head"><h2 class="vant-hl">{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="vant-sg">
      {%- for block in section.blocks limit: 3 -%}
        <a class="vant-sg__item vant-sg__item--{{ forloop.index }}" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="vant-sg__media">
            {%- if block.settings.image != blank -%}
              {%- liquid
                if forloop.first
                  assign sz = '(min-width: 750px) 60vw, 100vw'
                else
                  assign sz = '(min-width: 750px) 30vw, 100vw'
                endif
              -%}
              {{ block.settings.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: sz, loading: 'lazy', class: 'vant-img-cover', alt: block.settings.image.alt | default: block.settings.caption }}
            {%- else -%}
              <div class="vant-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
          <span class="vant-sg__caption">{{ block.settings.caption }} {% render 'vant-arrow' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .vant-sg {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 24px;
  }

  .vant-sg__item {
    color: inherit;
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }

  .vant-sg__item--1 {
    grid-row: span 2;
  }

  .vant-sg__media {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    aspect-ratio: 16 / 9.5;
  }

  .vant-sg__item--1 .vant-sg__media {
    aspect-ratio: auto;
  }

  .vant-sg__media img {
    transition: transform 0.6s ease;
  }

  .vant-sg__item:hover img {
    transform: scale(1.03);
  }

  .vant-sg__caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    font-size: 15px;
  }

  @media screen and (max-width: 749px) {
    .vant-sg {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .vant-sg__item--1 {
      grid-row: auto;
    }

    .vant-sg__item--1 .vant-sg__media {
      aspect-ratio: 4 / 3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vänt style gallery",
  "tag": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Three ways to style it" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Taupe velvet" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vänt style gallery",
      "blocks": [
        { "type": "look", "settings": { "caption": "Taupe velvet" } },
        { "type": "look", "settings": { "caption": "Dark velvet" } },
        { "type": "look", "settings": { "caption": "Charcoal velvet" } }
      ]
    }
  ]
}
{% endschema %}
