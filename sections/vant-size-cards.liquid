{% render 'vant-base' %}
<div
  class="section section--page-width vant-section"
  style="--vant-pt: {{ section.settings.padding_top }}px; --vant-pb: {{ section.settings.padding_bottom }}px;"
>
  <div>
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="vant-section-head vant-size__head">
        {%- if section.settings.heading != blank -%}<h2 class="vant-hl">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="vant-muted">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="vant-size">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign img = block.settings.image
          if img == blank and p != blank
            assign img = p.featured_image
          endif
          assign link = block.settings.link
          if link == blank and p != blank
            assign link = p.url
          endif
        -%}
        <a class="vant-size__card" href="{{ link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="vant-size__media">
            {%- if block.settings.dimension != blank -%}
              <span class="vant-size__dim"><span>{{ block.settings.dimension }}</span></span>
            {%- endif -%}
            {%- if block.settings.badge != blank -%}
              <span class="vant-size__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if img != blank -%}
              {{ img | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', class: 'vant-size__img', alt: img.alt }}
            {%- endif -%}
          </div>
          <div class="vant-size__body">
            <h3 class="vant-size__title">{{ block.settings.title }}</h3>
            {%- if block.settings.price_text != blank -%}<p class="vant-size__price">{{ block.settings.price_text }}</p>{%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <span class="vant-text-link vant-size__link">{{ block.settings.link_label }} {% render 'vant-arrow' %}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .vant-size__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
  }

  .vant-size__head p {
    margin: 0;
    max-width: 320px;
    font-size: 14px;
  }

  .vant-size {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
  }

  .vant-size__card {
    display: flex;
    flex-direction: column;
    border: 1px solid #dcd8d5;
    color: inherit;
    text-decoration: none;
    background: #fff;
    transition: border-color 0.2s ease;
  }

  .vant-size__card:hover {
    border-color: #2e2a2b;
  }

  .vant-size__media {
    position: relative;
    background: #f5f3f1;
    aspect-ratio: 1 / 0.9;
    display: grid;
    place-items: center;
    padding: 44px 16px 12px;
  }

  .vant-size__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .vant-size__dim {
    position: absolute;
    top: 14px;
    left: 12%;
    right: 12%;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #4a4446;
  }

  .vant-size__dim::before,
  .vant-size__dim::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #2e2a2b;
  }

  .vant-size__badge {
    position: absolute;
    top: 42px;
    right: 10px;
    background: #e0262b;
    color: #fff;
    font-size: 12px;
    padding: 4px 8px;
  }

  .vant-size__body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .vant-size__title {
    font-size: 20px;
    font-weight: 400;
  }

  .vant-size__price {
    margin: 4px 0 0;
    font-size: 15px;
  }

  .vant-size__link {
    margin-top: auto;
    padding-top: 28px;
    align-self: flex-start;
    font-size: 13px;
  }

  .vant-size__link {
    border-bottom: 0;
    background: linear-gradient(currentColor, currentColor) left bottom / 100% 1px no-repeat;
  }

  @media screen and (max-width: 989px) {
    .vant-size {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
  }

  @media screen and (max-width: 749px) {
    .vant-size__body {
      padding: 14px 14px 16px;
    }

    .vant-size__title {
      font-size: 17px;
    }

    .vant-size__link {
      padding-top: 18px;
      font-size: 12px;
    }

    .vant-size__media {
      padding: 38px 8px 8px;
    }

    .vant-size__badge {
      top: 36px;
      right: 6px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vänt size cards",
  "tag": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Shop by bed size" },
    { "type": "text", "id": "text", "label": "Text (optional)" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "size",
      "name": "Size card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product for the picture", "info": "Its main image is used unless you pick an image below." },
        { "type": "image_picker", "id": "image", "label": "Image (overrides the product image)" },
        { "type": "text", "id": "dimension", "label": "Width label", "default": "152cm" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "info": "e.g. Most popular" },
        { "type": "text", "id": "title", "label": "Title", "default": "Double & King beds" },
        { "type": "text", "id": "price_text", "label": "Price text", "default": "from £160" },
        { "type": "text", "id": "link_label", "label": "Link text", "default": "Shop Double & King" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vänt size cards",
      "blocks": [
        { "type": "size", "settings": { "dimension": "91cm", "title": "Single bed", "price_text": "from £165", "link_label": "Shop Single" } },
        { "type": "size", "settings": { "dimension": "152cm", "badge": "Most popular", "title": "Double & King beds", "price_text": "from £160", "link_label": "Shop Double & King" } },
        { "type": "size", "settings": { "dimension": "183cm", "title": "Super King beds", "price_text": "from £165", "link_label": "Shop Super King" } },
        { "type": "size", "settings": { "dimension": "Up to 305cm", "title": "Feature walls", "price_text": "from £330", "link_label": "Shop feature walls" } }
      ]
    }
  ]
}
{% endschema %}
