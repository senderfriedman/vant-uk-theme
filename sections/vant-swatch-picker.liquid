{% render 'vant-base' %}
{%- liquid
  assign s = section.settings
  assign source = s.collection
  if source == blank
    assign source = collection
  endif

  comment
    Group the swatch products by fabric display name (first option value, e.g. "Velvet"; "Leather" shows as "Vintage Leather").
  endcomment
  assign group_names = ''
  for p in source.products
    assign raw = p.variants.first.option1
    capture fname
      render 'vant-fabric-name', name: raw
    endcapture
    assign fname = fname | strip
    assign key = fname | append: '§'
    unless group_names contains key
      assign group_names = group_names | append: key
    endunless
  endfor

  comment
    Order: blocks first (in their order), then any fabric without a block.
  endcomment
  assign ordered = ''
  for block in section.blocks
    capture bname
      render 'vant-fabric-name', name: block.settings.fabric
    endcapture
    assign key = bname | strip | append: '§'
    if group_names contains key
      unless ordered contains key
        assign ordered = ordered | append: key
      endunless
    endif
  endfor
  assign all_groups = group_names | split: '§'
  for gname in all_groups
    assign key = gname | append: '§'
    unless ordered contains key
      assign ordered = ordered | append: key
    endunless
  endfor
  assign groups = ordered | split: '§'
-%}

<div
  class="section section--page-width vant-section vant-sp"
  style="--vant-pt: {{ s.padding_top }}px; --vant-pb: {{ s.padding_bottom }}px;"
  data-vant-swatches
  data-section-id="{{ section.id }}"
>
  <div>
    {%- if s.show_breadcrumb -%}
      <nav class="vant-crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li aria-current="page">{{ s.crumb_label | default: source.title }}</li>
        </ol>
      </nav>
    {%- endif -%}

    <header class="vant-sp__head">
      <h1 class="vant-sp__title vant-hl">{{ s.heading }}</h1>
      {%- if s.intro != blank -%}<p class="vant-sp__intro">{{ s.intro }}</p>{%- endif -%}
    </header>

    {%- if s.step_1 != blank or s.step_2 != blank or s.step_3 != blank -%}
      <ol class="vant-sp__steps">
        {%- if s.step_1 != blank -%}<li>{% render 'vant-icon', icon: 'swatch' %}<span><b>1</b> {{ s.step_1 }}</span></li>{%- endif -%}
        {%- if s.step_2 != blank -%}<li>{% render 'vant-icon', icon: 'mail' %}<span><b>2</b> {{ s.step_2 }}</span></li>{%- endif -%}
        {%- if s.step_3 != blank -%}<li>{% render 'vant-icon', icon: 'layers' %}<span><b>3</b> {{ s.step_3 }}</span></li>{%- endif -%}
      </ol>
    {%- endif -%}

    <nav class="vant-sp__nav" aria-label="Fabrics">
      <div class="vant-sp__nav-inner">
        {%- for gname in groups -%}
          {%- liquid
            assign gblock = nil
            for block in section.blocks
              capture bname
                render 'vant-fabric-name', name: block.settings.fabric
              endcapture
              assign bname = bname | strip
              if bname == gname
                assign gblock = block
              endif
            endfor
          -%}
          <a href="#vant-fabric-{{ section.id }}-{{ gname | handleize }}">{{ gblock.settings.nav_label | default: gname }}</a>
        {%- endfor -%}
      </div>
    </nav>

    {%- for gname in groups -%}
      {%- liquid
        assign gblock = nil
        for block in section.blocks
          capture bname
            render 'vant-fabric-name', name: block.settings.fabric
          endcapture
          assign bname = bname | strip
          if bname == gname
            assign gblock = block
          endif
        endfor
        assign popular = gblock.settings.popular | downcase | split: ','
      -%}
      <section class="vant-sp__group" id="vant-fabric-{{ section.id }}-{{ gname | handleize }}" {% if gblock %}{{ gblock.shopify_attributes }}{% endif %}>
        <h2 class="vant-sp__gtitle">{{ gblock.settings.heading | default: gname }}</h2>
        {%- if gblock.settings.text != blank -%}<p class="vant-sp__gtext">{{ gblock.settings.text }}</p>{%- endif -%}
        {%- if gblock.settings.tags != blank -%}
          <ul class="vant-chips">
            {%- assign tags = gblock.settings.tags | split: ',' -%}
            {%- for t in tags -%}<li>{{ t | strip }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
        <div class="vant-sp__grid">
          {%- for p in source.products -%}
            {%- liquid
              assign v = p.selected_or_first_available_variant
              capture fname
                render 'vant-fabric-name', name: p.variants.first.option1
              endcapture
              assign fname = fname | strip
              if fname != gname
                continue
              endif
              assign colour = v.option2 | default: p.title
              if p.variants.first.option1 == 'Wood' or p.variants.first.option1 == 'wood'
                assign colour = v.option2 | default: p.title
              endif
              assign colour_down = colour | downcase | strip
              assign is_popular = false
              for pc in popular
                assign pcs = pc | strip
                if pcs != blank and pcs == colour_down
                  assign is_popular = true
                endif
              endfor
              assign display = fname | append: ' ' | append: colour
              if gblock.settings.heading != blank and gblock.settings.heading != gname
                assign display = colour
              endif
            -%}
            <div class="vant-sp__tile{% unless v.available %} is-out{% endunless %}" data-vant-swatch data-id="{{ v.id }}" data-handle="{{ p.handle }}" data-name="{{ fname | escape }} {{ colour | escape }}" data-price="{{ v.price }}">
              <button
                type="button"
                class="vant-sp__pick"
                aria-pressed="false"
                aria-label="{{ fname | escape }} {{ colour | escape }}{% unless v.available %}, out of stock{% endunless %}"
                {% unless v.available %}disabled{% endunless %}
              >
                <span class="vant-sp__img">
                  {%- if p.featured_image != blank -%}
                    {{ p.featured_image | image_url: width: 500, height: 500, crop: 'center' | image_tag: widths: '250, 375, 500', sizes: '(min-width: 990px) 15vw, (min-width: 750px) 25vw, 45vw', loading: 'lazy', alt: '' }}
                  {%- endif -%}
                  {%- if is_popular -%}<span class="vant-badge">{{ s.popular_label }}</span>{%- endif -%}
                  <span class="vant-sp__check" aria-hidden="true"></span>
                </span>
              </button>
              {%- if p.featured_image != blank -%}
                <button
                  type="button"
                  class="vant-sp__zoom"
                  data-vant-zoom="{{ p.featured_image | image_url: width: 1400 }}"
                  data-caption="{{ fname | escape }} {{ colour | escape }}"
                  aria-label="View {{ fname | escape }} {{ colour | escape }} larger"
                >
                  <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M12.5 12.5l4.5 4.5M8.5 6v5M6 8.5h5"/></svg>
                </button>
              {%- endif -%}
              <p class="vant-sp__name">
                {{ colour }}
                {%- if v.price > 0 %} <span class="vant-sp__price">{{ v.price | money }}</span>{% endif -%}
                {%- unless v.available %} <span class="vant-sp__price">Out of stock</span>{% endunless -%}
              </p>
            </div>
          {%- endfor -%}
        </div>
      </section>
    {%- endfor -%}

    {%- if s.after_heading != blank -%}
      <div class="vant-sp__after">
        <h2 class="vant-hl">{{ s.after_heading }}</h2>
        <ol class="vant-sp__after-steps">
          {%- if s.after_1 != blank -%}<li><span class="vant-sp__num">01</span><div class="vant-rte">{{ s.after_1 }}</div></li>{%- endif -%}
          {%- if s.after_2 != blank -%}
            <li>
              <span class="vant-sp__num">02</span>
              <div>
                <div class="vant-rte">{{ s.after_2 }}</div>
                <div class="vant-buttons">
                  {%- if s.after_button_1 != blank -%}<a class="button button-secondary" href="{{ s.after_link_1 | default: '#' }}">{{ s.after_button_1 }} {% render 'vant-arrow' %}</a>{%- endif -%}
                  {%- if s.after_button_2 != blank -%}<a class="button button-secondary" href="{{ s.after_link_2 | default: '#' }}">{{ s.after_button_2 }} {% render 'vant-arrow' %}</a>{%- endif -%}
                </div>
              </div>
            </li>
          {%- endif -%}
        </ol>
      </div>
    {%- endif -%}

    <div class="vant-sp__tray" data-vant-tray>
      <div class="vant-sp__tray-inner">
        <div class="vant-sp__tray-info">
          <p class="vant-sp__tray-count" aria-live="polite"><span data-vant-tray-count>0</span> <span data-vant-tray-word>swatches</span> selected</p>
          <p class="vant-sp__tray-note">{{ s.tray_note }}</p>
          <ul class="vant-sp__tray-thumbs" data-vant-tray-thumbs></ul>
        </div>
        <div class="vant-sp__tray-actions">
          <button type="button" class="vant-text-link vant-sp__clear" data-vant-tray-clear hidden>Clear</button>
          <button type="button" class="button" data-vant-tray-add disabled>{{ s.tray_button }}</button>
        </div>
      </div>
      <p class="vant-sp__tray-error" role="alert" data-vant-tray-error hidden></p>
    </div>
  </div>

  <dialog class="vant-dialog vant-sp__dialog" data-vant-zoom-dialog>
    <div class="vant-dialog__inner">
      <button type="button" class="vant-dialog__close" data-vant-zoom-close aria-label="Close">×</button>
      <img src="" alt="" data-vant-zoom-img>
      <p class="vant-sp__dialog-caption" data-vant-zoom-caption></p>
    </div>
  </dialog>
</div>

<script type="module" src="{{ 'vant-cart.js' | asset_url }}"></script>
<script>
  (() => {
    const init = (root) => {
      if (!root || root.dataset.ready) return;
      root.dataset.ready = '1';
      const storeKey = 'vant-swatches-selected';
      const tiles = Array.from(root.querySelectorAll('[data-vant-swatch]'));
      const count = root.querySelector('[data-vant-tray-count]');
      const word = root.querySelector('[data-vant-tray-word]');
      const thumbs = root.querySelector('[data-vant-tray-thumbs]');
      const addBtn = root.querySelector('[data-vant-tray-add]');
      const clearBtn = root.querySelector('[data-vant-tray-clear]');
      const errorEl = root.querySelector('[data-vant-tray-error]');
      const addLabel = addBtn.textContent;
      const selected = new Set();

      const save = () => {
        try {
          sessionStorage.setItem(storeKey, JSON.stringify(Array.from(selected)));
        } catch (e) {}
      };

      const update = () => {
        tiles.forEach((tile) => {
          const on = selected.has(tile.dataset.id);
          tile.classList.toggle('is-selected', on);
          tile.querySelector('.vant-sp__pick').setAttribute('aria-pressed', String(on));
        });
        const n = selected.size;
        count.textContent = n;
        word.textContent = n === 1 ? 'swatch' : 'swatches';
        addBtn.disabled = n === 0;
        clearBtn.hidden = n === 0;
        thumbs.innerHTML = '';
        tiles
          .filter((t) => selected.has(t.dataset.id))
          .forEach((t) => {
            const img = t.querySelector('img');
            const li = document.createElement('li');
            li.title = t.dataset.name;
            if (img) li.style.backgroundImage = `url("${img.currentSrc || img.src}")`;
            thumbs.appendChild(li);
          });
        save();
      };

      const toggle = (tile, force) => {
        if (tile.classList.contains('is-out')) return;
        const id = tile.dataset.id;
        const on = force !== undefined ? force : !selected.has(id);
        if (on) selected.add(id);
        else selected.delete(id);
      };

      tiles.forEach((tile) => {
        tile.querySelector('.vant-sp__pick').addEventListener('click', () => {
          toggle(tile);
          update();
        });
      });

      // Keep choices if the shopper leaves and comes back in the same visit
      try {
        const saved = JSON.parse(sessionStorage.getItem(storeKey) || '[]');
        saved.forEach((id) => {
          const tile = tiles.find((t) => t.dataset.id === id);
          if (tile) toggle(tile, true);
        });
      } catch (e) {}

      // ?colour=velvet-sand-storm from product pages: select it and scroll to it
      const wanted = new URLSearchParams(window.location.search).get('colour');
      if (wanted) {
        const key = wanted.toLowerCase();
        const norm = (t) =>
          t
            .toLowerCase()
            .normalize('NFD')
            .replace(/[̀-ͯ]/g, '')
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
        const tile =
          tiles.find((t) => t.dataset.handle === key) ||
          tiles.find((t) => norm(t.dataset.name) === key) ||
          tiles.find((t) => key.endsWith(norm(t.dataset.name.split(' ').slice(-2).join(' '))));
        if (tile) {
          toggle(tile, true);
          requestAnimationFrame(() =>
            requestAnimationFrame(() => tile.scrollIntoView({ block: 'center', behavior: 'smooth' }))
          );
        }
      }

      update();

      clearBtn.addEventListener('click', () => {
        selected.clear();
        update();
      });

      addBtn.addEventListener('click', async () => {
        if (!selected.size) return;
        errorEl.hidden = true;
        if (!window.VantCart) {
          window.location.href = `/cart/${Array.from(selected).map((id) => `${id}:1`).join(',')}`;
          return;
        }
        addBtn.disabled = true;
        addBtn.textContent = 'Adding…';
        try {
          await window.VantCart.add(
            Array.from(selected).map((id) => ({ id, quantity: 1 })),
            addBtn
          );
          selected.clear();
          update();
        } catch (error) {
          errorEl.textContent = (error && error.message) || 'Sorry, those swatches could not be added. Please try again.';
          errorEl.hidden = false;
        } finally {
          addBtn.textContent = addLabel;
          addBtn.disabled = selected.size === 0;
        }
      });

      // View larger
      const dialog = root.querySelector('[data-vant-zoom-dialog]');
      const zImg = root.querySelector('[data-vant-zoom-img]');
      const zCap = root.querySelector('[data-vant-zoom-caption]');
      root.querySelectorAll('[data-vant-zoom]').forEach((btn) => {
        btn.addEventListener('click', () => {
          zImg.src = btn.dataset.vantZoom;
          zImg.alt = btn.dataset.caption;
          zCap.textContent = btn.dataset.caption;
          if (dialog.showModal) dialog.showModal();
        });
      });
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog || e.target.closest('[data-vant-zoom-close]')) dialog.close();
      });
    };
    document.querySelectorAll('[data-vant-swatches]').forEach(init);
    document.addEventListener('shopify:section:load', (e) => init(e.target.querySelector('[data-vant-swatches]')));
  })();
</script>

{% stylesheet %}
  .vant-sp .vant-crumbs ol {
    padding-top: 0;
  }

  .vant-sp__head {
    padding: 6px 0 24px;
  }

  .vant-sp__title {
    margin: 0 0 12px;
    font-size: clamp(32px, 4vw, 48px);
  }

  .vant-sp__intro {
    margin: 0;
    max-width: 640px;
  }

  .vant-sp__steps {
    list-style: none;
    margin: 0;
    padding: 18px 0;
    border-top: 1px solid #dcd8d5;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .vant-sp__steps li {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 14px;
  }

  .vant-sp__steps svg {
    width: 22px;
    height: 22px;
    flex: none;
  }

  .vant-sp__steps b {
    font-weight: 500;
    color: #ef2e32;
    margin-right: 4px;
  }

  .vant-sp__nav {
    position: sticky;
    top: var(--header-height, 0px);
    z-index: 3;
    background: #fff;
    border-top: 1px solid #dcd8d5;
    border-bottom: 1px solid #dcd8d5;
  }

  .vant-sp__nav-inner {
    display: flex;
    gap: 28px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .vant-sp__nav-inner::-webkit-scrollbar {
    display: none;
  }

  .vant-sp__nav a {
    flex: none;
    padding: 16px 0;
    font-size: 14px;
    color: #4a4446;
    text-decoration: none;
    white-space: nowrap;
  }

  .vant-sp__nav a:hover {
    color: #2e2a2b;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .vant-sp__group {
    padding: 36px 0 40px;
    border-bottom: 1px solid #dcd8d5;
    scroll-margin-top: calc(var(--header-height, 80px) + 64px);
  }

  .vant-sp__gtitle {
    margin: 0 0 6px;
    font-size: 32px;
  }

  .vant-sp__gtext {
    margin: 0 0 12px;
    font-size: 15px;
    color: #6b6466;
  }

  .vant-sp__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 28px 16px;
    margin-top: 18px;
  }

  .vant-sp__tile {
    position: relative;
  }

  .vant-sp__pick {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .vant-sp__pick[disabled] {
    cursor: not-allowed;
  }

  .vant-sp__img {
    position: relative;
    display: block;
    aspect-ratio: 1;
    background: #f5f3f1;
    overflow: hidden;
    outline: 2px solid transparent;
    outline-offset: 3px;
    transition: outline-color 0.2s ease;
  }

  .vant-sp__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .vant-sp__pick:hover .vant-sp__img img {
    transform: scale(1.04);
  }

  .vant-sp__tile.is-out .vant-sp__img {
    opacity: 0.45;
  }

  .vant-sp__check {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 4px rgb(46 42 43 / 0.2);
    display: grid;
    place-items: center;
  }

  .vant-sp__check::before {
    content: '+';
    font-size: 20px;
    line-height: 1;
    color: #2e2a2b;
  }

  .vant-sp__tile.is-selected .vant-sp__img {
    outline-color: #2e2a2b;
  }

  .vant-sp__tile.is-selected .vant-sp__check {
    background: #2e2a2b;
  }

  .vant-sp__tile.is-selected .vant-sp__check::before {
    content: '';
    width: 11px;
    height: 6px;
    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;
    transform: translateY(-2px) rotate(-45deg);
  }

  .vant-sp__zoom {
    position: absolute;
    right: 8px;
    bottom: calc(1.6em + 18px);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 0;
    background: rgb(255 255 255 / 0.92);
    display: grid;
    place-items: center;
    cursor: pointer;
    color: #2e2a2b;
  }

  .vant-sp__name {
    margin: 10px 0 0;
    font-size: 14px;
    color: #2e2a2b;
  }

  .vant-sp__price {
    color: #6b6466;
    font-size: 13px;
  }

  .vant-sp__after {
    padding: 56px 0 24px;
  }

  .vant-sp__after-steps {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
  }

  .vant-sp__after-steps li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 8px;
    border-bottom: 1px solid #dcd8d5;
    padding-bottom: 24px;
  }

  .vant-sp__num {
    color: #ef2e32;
    font-size: 18px;
  }

  .vant-sp__after .vant-buttons {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .vant-sp__tray {
    position: sticky;
    bottom: 0;
    z-index: 5;
    margin-top: 32px;
    background: #fff;
    box-shadow: 0 -1px 0 #dcd8d5, 0 -8px 24px rgb(46 42 43 / 0.06);
    margin-left: calc(-1 * var(--page-margin, 0px));
    margin-right: calc(-1 * var(--page-margin, 0px));
    padding: 12px var(--page-margin, 16px) calc(12px + env(safe-area-inset-bottom));
  }

  .vant-sp__tray-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .vant-sp__tray-info {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .vant-sp__tray-count {
    margin: 0;
    font-size: 15px;
    color: #2e2a2b;
  }

  .vant-sp__tray-note {
    margin: 0;
    font-size: 12px;
    color: #6b6466;
  }

  .vant-sp__tray-thumbs {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .vant-sp__tray-thumbs:empty {
    display: none;
  }

  .vant-sp__tray-thumbs li {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #dcd8d5 center / cover no-repeat;
    box-shadow: inset 0 0 0 1px rgb(46 42 43 / 0.15);
  }

  .vant-sp__tray-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: none;
  }

  .vant-sp__clear {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  .vant-sp__tray .button[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .vant-sp__tray-error {
    color: #c81e23;
    font-size: 14px;
    margin: 8px 0 0;
  }

  .vant-sp__dialog {
    max-width: min(760px, calc(100vw - 32px));
  }

  .vant-sp__dialog img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 72vh;
    object-fit: contain;
    background: #f5f3f1;
  }

  .vant-sp__dialog-caption {
    margin: 12px 0 0;
    font-size: 15px;
    color: #2e2a2b;
  }

  @media screen and (max-width: 1199px) {
    .vant-sp__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .vant-sp__steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }

    .vant-sp__nav-inner {
      -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
      mask-image: linear-gradient(90deg, #000 85%, transparent);
      padding-right: 40px;
      gap: 22px;
    }

    .vant-sp__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 12px;
    }

    .vant-sp__gtitle {
      font-size: 26px;
    }

    .vant-sp__after-steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .vant-sp__tray .button {
      --button-padding-inline: 16px;
    }
  }
{% endstylesheet %}

