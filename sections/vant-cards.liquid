{% render 'vant-base' %}
{%- assign s = section.settings -%}
<div
  class="section section--page-width vant-section"
  style="--vant-pt: {{ s.padding_top }}px; --vant-pb: {{ s.padding_bottom }}px;"
>
  <div>
    {%- if s.heading != blank -%}<div class="vant-section-head"><h2 class="vant-hl">{{ s.heading }}</h2></div>{%- endif -%}
    <div class="vant-cards" style="--cols: {{ s.columns }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- if b.link != blank -%}
          <a class="vant-cards__card vant-cards__card--link" href="{{ b.link }}" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="vant-cards__card" {{ block.shopify_attributes }}>
        {%- endif -%}
          {%- if b.image != blank -%}
            <span class="vant-cards__img">
              {{ b.image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 45vw, 92vw', loading: 'lazy', alt: '' }}
              {%- if b.image_label != blank -%}<span class="vant-img-label">{{ b.image_label }}</span>{%- endif -%}
            </span>
          {%- endif -%}
          {%- if b.icon != 'none' -%}<span class="vant-cards__icon">{% render 'vant-icon', icon: b.icon %}</span>{%- endif -%}
          <span class="vant-cards__title">{{ b.title }}</span>
          {%- if b.text != blank -%}<span class="vant-cards__text">{{ b.text }}</span>{%- endif -%}
          {%- if b.link != blank -%}<span class="vant-cards__go">{% render 'vant-arrow' %}</span>{%- endif -%}
        {%- if b.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .vant-cards {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    gap: 16px;
  }

  .vant-cards__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 48px 26px 24px;
    background: #f5f3f1;
    border: 1px solid #dcd8d5;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .vant-cards__card:has(.vant-cards__img) {
    padding-top: 0;
  }

  .vant-cards__img {
    position: relative;
    display: block;
    margin: 0 -48px 10px -24px;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .vant-cards__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vant-cards__img .vant-img-label {
    position: absolute;
    left: 10px;
    bottom: 10px;
  }

  .vant-cards__card:has(.vant-cards__img) .vant-cards__go {
    top: auto;
    bottom: 24px;
  }

  .vant-cards__card--link:hover {
    border-color: #2e2a2b;
  }

  .vant-cards__icon .vant-icon {
    width: 28px;
    height: 28px;
    color: #2e2a2b;
    margin-bottom: 6px;
  }

  .vant-cards__title {
    font-size: 22px;
    color: #2e2a2b;
    line-height: 1.2;
  }

  .vant-cards__text {
    font-size: 15px;
  }

  .vant-cards__go {
    position: absolute;
    top: 24px;
    right: 22px;
  }

  @media screen and (max-width: 989px) {
    .vant-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .vant-cards {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .vant-cards__card {
      padding: 18px 44px 20px 18px;
    }

    .vant-cards__img {
      margin: 0 -44px 8px -18px;
    }

    .vant-cards__title {
      font-size: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vänt cards",
  "tag": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "columns", "label": "Cards per row (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "tools", "label": "Tools" },
            { "value": "grid", "label": "Layout grid" },
            { "value": "book", "label": "Fabric book" },
            { "value": "swatch", "label": "Swatch" },
            { "value": "delivery", "label": "Delivery" },
            { "value": "returns", "label": "Returns" },
            { "value": "warranty", "label": "Warranty" },
            { "value": "phone", "label": "Phone" },
            { "value": "tag", "label": "Price tag" },
            { "value": "person", "label": "Person" },
            { "value": "box", "label": "Box" },
            { "value": "mail", "label": "Email" },
            { "value": "bracket", "label": "Bracket" },
            { "value": "layers", "label": "Layers" }
          ],
          "default": "none"
        },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "image_label", "label": "Image label", "info": "e.g. Styled room concept" },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave empty for a card that isn't a link (no arrow)." }
      ]
    }
  ],
  "presets": [{ "name": "Vänt cards", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
