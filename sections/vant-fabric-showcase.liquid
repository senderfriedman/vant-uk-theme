{% render 'vant-base' %}
{%- liquid
  assign exclude = section.settings.exclude_fabrics | downcase | split: ','
  assign swatch_link = section.settings.button_link | default: section.settings.collection.url | default: '#'
-%}
{%- if section.settings.layout == 'feature' -%}
<div
  class="section section--page-width vant-section"
  style="--vant-pt: {{ section.settings.padding_top }}px; --vant-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="vant-fabf" style="--vant-fabf-bg: {{ section.settings.background_color | default: '#F1ECE8' }};">
    <div class="vant-fabf__fan" aria-label="Popular colours">
      {%- for p in section.settings.featured limit: 5 -%}
        <a
          class="vant-fabf__card"
          style="--i: {{ forloop.index0 }}; --n: {{ section.settings.featured.count | at_most: 5 }};"
          href="{{ swatch_link }}{% if swatch_link contains '?' %}&{% else %}?{% endif %}colour={{ p.handle }}"
        >
          <span class="vant-fabf__img">
            {%- if p.featured_image != blank -%}
              {{ p.featured_image | image_url: width: 500, height: 640, crop: 'center' | image_tag: widths: '240, 360, 500', sizes: '(min-width: 990px) 14vw, 30vw', loading: 'lazy', alt: '' }}
            {%- endif -%}
          </span>
          {%- capture fab_title -%}{{ p.title | replace: 'Boucle', 'Bouclé' }}{%- endcapture -%}
          <span class="vant-fabf__name">{{ fab_title }}</span>
        </a>
      {%- endfor -%}
    </div>
    <div class="vant-fabf__content">
      {%- if section.settings.eyebrow != blank -%}<p class="vant-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="vant-hl vant-fabf__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="vant-fabf__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="vant-buttons">
          <a class="button" href="{{ swatch_link }}">{{ section.settings.button_label }} {% render 'vant-arrow' %}</a>
        </div>
      {%- endif -%}
      {%- if section.settings.small_print != blank -%}<p class="vant-fabf__small">{{ section.settings.small_print }}</p>{%- endif -%}
    </div>
  </div>
</div>
{%- else -%}
<div
  class="section section--page-width vant-section"
  style="--vant-pt: {{ section.settings.padding_top }}px; --vant-pb: {{ section.settings.padding_bottom }}px; --vant-bg: {{ section.settings.background_color }};"
>
  <div class="vant-fab vant-fab--{{ section.settings.layout }}">
    <div class="vant-section-head vant-section-head--center">
      {%- if section.settings.heading != blank -%}<h2 class="vant-hl">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.small_print != blank -%}<p class="vant-small vant-muted">{{ section.settings.small_print }}</p>{%- endif -%}
    </div>

    {%- if section.settings.featured != blank -%}
      <div class="vant-fab__featured vant-scroll-row">
        {%- for p in section.settings.featured -%}
          <a class="vant-fab__swatch" href="{{ swatch_link }}{% if swatch_link contains '?' %}&{% else %}?{% endif %}colour={{ p.handle }}">
            <span class="vant-fab__circle">
              {%- if p.featured_image != blank -%}
                {{ p.featured_image | image_url: width: 500, height: 500, crop: 'center' | image_tag: widths: '240, 360, 500', sizes: '(min-width: 990px) 18vw, 40vw', loading: 'lazy', alt: '' }}
              {%- endif -%}
            </span>
            <span class="vant-fab__name">{{ p.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.collection != blank -%}
      {%- liquid
        assign fabrics = ''
        assign colour_count = 0
        for p in section.settings.collection.products
          if p.options.size < 2
            continue
          endif
          assign fabric = p.variants.first.option1
          if fabric == 'Leather'
            assign fabric = 'Vintage Leather'
          endif
          assign fabric_key = fabric | downcase | strip
          if exclude contains fabric_key
            continue
          endif
          assign colour_count = colour_count | plus: 1
          unless fabrics contains fabric
            assign fabrics = fabrics | append: fabric | append: '|'
          endunless
        endfor
        assign fabric_list = fabrics | split: '|'
      -%}
      <div class="vant-fab__all">
        <p class="vant-fab__all-label vant-small">{{ section.settings.all_label | replace: '[count]', colour_count }}</p>
        <div class="vant-fab__dots vant-scroll-row">
          {%- for fabric in fabric_list -%}
            <div class="vant-fab__group" role="group" aria-label="{{ fabric | escape }}">
              {%- for p in section.settings.collection.products -%}
                {%- liquid
                  if p.options.size < 2
                    continue
                  endif
                  assign f = p.variants.first.option1
                  if f == 'Leather'
                    assign f = 'Vintage Leather'
                  endif
                  if f != fabric
                    continue
                  endif
                -%}
                <a class="vant-fab__dot" href="{{ swatch_link }}{% if swatch_link contains '?' %}&{% else %}?{% endif %}colour={{ p.handle }}" title="{{ p.title | escape }}" aria-label="{{ p.title | escape }}">
                  {%- if p.featured_image != blank -%}
                    {{ p.featured_image | image_url: width: 80, height: 80, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
                  {%- endif -%}
                </a>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="vant-buttons vant-fab__cta">
        <a class="button" href="{{ swatch_link }}">{{ section.settings.button_label }} {% render 'vant-arrow' %}</a>
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  /* Feature banner: fanned swatch cards beside the text */
  .vant-fabf {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    background: var(--vant-fabf-bg, #f1ece8);
    padding: clamp(40px, 5vw, 72px) clamp(24px, 5vw, 72px);
    overflow: hidden;
  }

  .vant-fabf__fan {
    position: relative;
    height: clamp(260px, 26vw, 360px);
  }

  .vant-fabf__card {
    --offset: calc(var(--i) - (var(--n) - 1) / 2);
    position: absolute;
    left: 50%;
    bottom: 0;
    width: clamp(110px, 11vw, 160px);
    background: #fff;
    padding: 8px 8px 10px;
    box-shadow: 0 10px 28px rgb(46 42 43 / 0.16);
    color: #2e2a2b;
    text-decoration: none;
    transform-origin: 50% 120%;
    transform: translateX(calc(-50% + var(--offset) * 74%)) rotate(calc(var(--offset) * 9deg));
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    z-index: calc(10 - var(--i));
  }

  .vant-fabf__card:hover,
  .vant-fabf__card:focus-visible {
    transform: translateX(calc(-50% + var(--offset) * 74%)) translateY(-18px) rotate(calc(var(--offset) * 9deg));
    box-shadow: 0 18px 36px rgb(46 42 43 / 0.22);
    z-index: 20;
  }

  .vant-fabf__img {
    display: block;
    aspect-ratio: 25 / 32;
    background: #e9e5e2;
    overflow: hidden;
  }

  .vant-fabf__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vant-fabf__name {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    line-height: 1.3;
    text-align: center;
  }

  .vant-fabf__title {
    margin: 8px 0 14px;
    font-size: clamp(32px, 3.6vw, 46px);
    line-height: 1.08;
  }

  .vant-fabf__text {
    margin: 0 0 24px;
    font-size: 16px;
    max-width: 420px;
  }

  .vant-fabf__small {
    margin: 12px 0 0;
    font-size: 13px;
    color: #6b6466;
  }

  @media screen and (max-width: 989px) {
    .vant-fabf {
      grid-template-columns: minmax(0, 1fr);
    }

    .vant-fabf__content {
      order: -1;
    }

    .vant-fabf__fan {
      height: 230px;
    }

    .vant-fabf__card {
      width: 112px;
    }
  }

  @media screen and (max-width: 749px) {
    .vant-fabf__card {
      width: 96px;
      padding: 6px 6px 8px;
      transform: translateX(calc(-50% + var(--offset) * 62%)) rotate(calc(var(--offset) * 7deg));
    }

    .vant-fabf__card:hover,
    .vant-fabf__card:focus-visible {
      transform: translateX(calc(-50% + var(--offset) * 62%)) translateY(-12px) rotate(calc(var(--offset) * 7deg));
    }

    .vant-fabf__fan {
      height: 200px;
    }

    .vant-fabf .vant-buttons .button {
      width: 100%;
      justify-content: center;
    }
  }

  /* Compact strip: text left, small circles middle, button right */
  .vant-fab--compact {
    display: grid;
    grid-template-columns: minmax(220px, minmax(0, 1.1fr)) minmax(0, 2fr) auto;
    align-items: center;
    gap: 32px;
  }

  .vant-fab--compact .vant-section-head {
    text-align: left;
    margin: 0;
    max-width: none;
  }

  .vant-fab--compact .vant-section-head h2 {
    font-size: 28px;
  }

  .vant-fab--compact .vant-section-head p {
    font-size: 14px;
    margin-top: 8px;
  }

  .vant-fab--compact .vant-fab__featured {
    grid-auto-columns: minmax(64px, 1fr);
    gap: 14px;
    margin: 0;
  }

  .vant-fab--compact .vant-fab__swatch {
    font-size: 12px;
    gap: 8px;
  }

  .vant-fab--compact .vant-fab__circle {
    max-width: 88px;
  }

  .vant-fab--compact .vant-fab__cta {
    margin: 0;
  }

  .vant-fab--compact .vant-fab__cta .button {
    background: transparent;
    color: #2e2a2b;
    box-shadow: inset 0 0 0 1px #2e2a2b;
  }

  @media screen and (max-width: 989px) {
    .vant-fab--compact {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }

  .vant-fab__featured {
    grid-auto-columns: calc((100% - 4 * 28px) / 5);
    gap: 28px;
    margin-top: 8px;
  }

  .vant-fab__swatch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    color: inherit;
    text-decoration: none;
    text-align: center;
    font-size: 15px;
  }

  .vant-fab__circle {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: #e9e5e2;
    box-shadow: 0 8px 22px rgb(46 42 43 / 0.08);
    transition: transform 0.25s ease;
  }

  .vant-fab__swatch:hover .vant-fab__circle {
    transform: translateY(-3px);
  }

  .vant-fab__circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vant-fab__all {
    margin-top: 44px;
    text-align: center;
  }

  .vant-fab__all-label {
    margin: 0 0 14px;
  }

  .vant-fab__dots {
    grid-auto-columns: max-content;
    justify-content: center;
    gap: 0;
  }

  .vant-fab__group {
    display: flex;
    gap: 8px;
    padding-inline: 12px;
    border-left: 1px solid #dcd8d5;
  }

  .vant-fab__group:first-child {
    border-left: 0;
  }

  .vant-fab__dot {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    overflow: hidden;
    background: #e9e5e2;
    outline: 1px solid rgb(46 42 43 / 0.12);
    outline-offset: -1px;
    position: relative;
  }

  .vant-fab__dot::after {
    content: '';
    position: absolute;
    inset: -7px;
  }

  .vant-fab__dot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vant-fab__cta {
    justify-content: center;
    margin-top: 36px;
  }

  @media screen and (max-width: 1199px) {
    .vant-fab__dots.vant-scroll-row {
      justify-content: start;
      -webkit-mask-image: linear-gradient(to right, #000 85%, transparent);
      mask-image: linear-gradient(to right, #000 85%, transparent);
    }
  }

  @media screen and (max-width: 749px) {
    .vant-fab__featured {
      grid-auto-columns: 38%;
      gap: 16px;
    }

    .vant-fab__swatch {
      font-size: 13px;
    }

    .vant-fab__cta .button {
      width: 100%;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vänt fabric showcase",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "stacked",
          "label": "Large (centred, big circles)"
        },
        {
          "value": "compact",
          "label": "Compact strip"
        },
        {
          "value": "feature",
          "label": "Feature banner (fanned swatches)"
        }
      ],
      "default": "stacked"
    },
    { "type": "text", "id": "eyebrow", "label": "Small label", "info": "Feature banner only." },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Make words italic to show them in red.",
      "default": "Feel the fabric <em>before you choose.</em>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "7 fabrics, 26 colours. Choose as many colours as you like, for one flat £3.50 postage."
    },
    {
      "type": "text",
      "id": "small_print",
      "label": "Small print",
      "default": "Colours vary by screen. A swatch shows the real shade."
    },
    {
      "type": "product_list",
      "id": "featured",
      "label": "Featured swatches (big circles)",
      "limit": 5
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "All colours row: swatch collection",
      "info": "Shows every colour in this collection, grouped by fabric (the product's first option)."
    },
    {
      "type": "text",
      "id": "exclude_fabrics",
      "label": "Fabrics to leave out of the row",
      "info": "Comma separated, e.g. Wood",
      "default": "Wood"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Row label",
      "info": "[count] is replaced by the number of colours.",
      "default": "All [count] colours"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Order swatches"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Uses the collection link if empty."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F5F3F1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Vänt fabric showcase"
    }
  ]
}
{% endschema %}
