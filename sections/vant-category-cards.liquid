{% render 'vant-base' %}
<div
  class="section section--page-width vant-section"
  style="--vant-pt: {{ section.settings.padding_top }}px; --vant-pb: {{ section.settings.padding_bottom }}px;"
>
  <div>
    {%- if section.settings.heading != blank -%}
      <div class="vant-section-head"><h2 class="vant-hl">{{ section.settings.heading }}</h2></div>
    {%- endif -%}

    <div class="vant-cat vant-scroll-row">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image
          if img == blank and c != blank
            assign img = c.featured_image
          endif
          assign title = block.settings.title
          if title == blank and c != blank
            assign title = c.title
          endif
          assign link = block.settings.link
          if link == blank and c != blank
            assign link = c.url
          endif
        -%}
        <a class="vant-cat__card" href="{{ link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="vant-cat__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 750px) 25vw, 75vw', loading: 'lazy', class: 'vant-img-cover' }}
            {%- else -%}
              <div class="vant-placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
          <div class="vant-cat__meta">
            <h3 class="vant-cat__title">{{ title }}</h3>
            {%- if block.settings.price_text != blank -%}
              <span class="vant-cat__price">{{ block.settings.price_text }} {% render 'vant-arrow' %}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .vant-cat {
    grid-auto-columns: calc((100% - 3 * 22px) / 4);
    gap: 22px;
  }

  .vant-cat__card {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .vant-cat__media {
    aspect-ratio: 4 / 3.3;
    overflow: hidden;
    background: #f5f3f1;
  }

  .vant-cat__media img {
    transition: transform 0.6s ease;
  }

  .vant-cat__card:hover .vant-cat__media img {
    transform: scale(1.03);
  }

  .vant-cat__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-top: 16px;
  }

  .vant-cat__title {
    font-size: 20px;
    font-weight: 400;
  }

  .vant-cat__price {
    font-size: 13px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  @media screen and (min-width: 750px) {
    .vant-cat {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  @media screen and (max-width: 749px) {
    .vant-cat {
      grid-auto-columns: 72%;
      gap: 14px;
    }

    .vant-cat__meta {
      flex-direction: column;
      gap: 4px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vänt category cards",
  "tag": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Shop the bedroom" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Fills the image, title and link if left empty below." },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "title", "label": "Title (optional)" },
        { "type": "text", "id": "price_text", "label": "Price text", "default": "from £160" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vänt category cards",
      "blocks": [
        { "type": "card", "settings": { "title": "Headboard walls", "price_text": "from £160" } },
        { "type": "card", "settings": { "title": "Beds", "price_text": "from £619" } },
        { "type": "card", "settings": { "title": "Bedside tables", "price_text": "from £289.99" } },
        { "type": "card", "settings": { "title": "Bed benches", "price_text": "from £269" } }
      ]
    }
  ]
}
{% endschema %}
