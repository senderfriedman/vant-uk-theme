{% render 'vant-base' %}
{% render 'vant-video-dialog' %}
<div
  class="section section--page-width vant-section"
  style="--vant-pt: {{ section.settings.padding_top }}px; --vant-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="vant-vf{% if section.settings.media_position == 'right' %} vant-vf--right{% endif %}{% if section.settings.size == 'compact' %} vant-vf--compact{% endif %}" style="background: {{ section.settings.panel_color }};">
    <div class="vant-vf__media vant-vf__media--{{ section.settings.image_fit }}">
      {% render 'vant-pick-image', image: section.settings.image, product: section.settings.product, colour: section.settings.colour, widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 50vw, 100vw', class: 'vant-img-cover' %}
      {%- if section.settings.image_label != blank -%}<span class="vant-img-label">{{ section.settings.image_label }}</span>{%- endif -%}
      {%- if section.settings.youtube_id != blank -%}
        <button type="button" class="vant-vf__play" data-vant-video="{{ section.settings.youtube_id | escape }}" aria-label="Play: {{ section.settings.play_label | escape }}">
          <span class="vant-vf__play-icon"><svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M5 3v10l8-5z"/></svg></span>
          {%- if section.settings.play_label != blank -%}<span class="vant-vf__play-label">{{ section.settings.play_label }}</span>{%- endif -%}
        </button>
      {%- endif -%}
    </div>
    <div class="vant-vf__content">
      {%- if section.settings.eyebrow != blank -%}<p class="vant-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}
        {%- if section.settings.heading_level == 'h1' -%}
          <h1 class="vant-hl vant-vf__h1">{{ section.settings.heading }}</h1>
        {%- else -%}
          <h2 class="vant-hl">{{ section.settings.heading }}</h2>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.text != blank -%}<div class="vant-vf__text vant-rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="vant-buttons">
          <a class="button{% if section.settings.button_style == 'secondary' %} button-secondary{% endif %}" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }} {% render 'vant-arrow' %}</a>
        </div>
      {%- endif -%}
      {%- if section.settings.note != blank -%}<div class="vant-vf__note vant-rte">{{ section.settings.note }}</div>{%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .vant-vf {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: #f5f3f1;
  }

  .vant-vf--right .vant-vf__media {
    order: 2;
  }

  .vant-vf__media {
    position: relative;
    aspect-ratio: 4 / 3.2;
    overflow: hidden;
  }

  .vant-vf__media > img,
  .vant-vf__media > .vant-placeholder {
    position: absolute;
    inset: 0;
  }

  .vant-vf__media--contain > img {
    object-fit: contain;
    padding: 6%;
    mix-blend-mode: multiply;
  }

  .vant-vf__text ul {
    padding-left: 1.1em;
  }

  .vant-vf__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: #fff;
  }

  .vant-vf__play-icon {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: #2e2a2b;
    display: grid;
    place-items: center;
    transition: transform 0.2s ease;
  }

  .vant-vf__play:hover .vant-vf__play-icon {
    transform: scale(1.06);
  }

  .vant-vf__play-label {
    background: rgb(46 42 43 / 0.85);
    font-size: 13px;
    padding: 6px 12px;
  }

  .vant-vf__content {
    align-self: center;
    padding: 56px 64px;
  }

  .vant-vf__text {
    margin-top: 20px;
    max-width: 440px;
    line-height: 1.7;
  }

  .vant-vf__h1 {
    margin: 0;
    font-size: clamp(36px, 4.4vw, 60px);
    line-height: 1.05;
  }

  .vant-vf__note {
    margin-top: 18px;
    font-size: 14px;
  }

  .vant-vf__note a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .vant-vf__media .vant-img-label {
    position: absolute;
    left: 12px;
    bottom: 12px;
  }

  .vant-vf--compact .vant-vf__media {
    aspect-ratio: 16 / 9;
  }

  .vant-vf--compact .vant-vf__content {
    padding: 40px 48px;
  }

  .vant-vf--compact .vant-vf__text {
    margin-top: 12px;
  }

  .vant-vf--compact .vant-vf__text p + p {
    font-size: 13px;
    color: #6b6466;
  }

  .vant-vf .vant-eyebrow {
    margin-bottom: 10px;
  }

  @media screen and (max-width: 749px) {
    .vant-vf--compact .vant-vf__content {
      padding: 28px 24px 32px;
    }

    .vant-vf {
      grid-template-columns: 1fr;
    }

    .vant-vf--right .vant-vf__media {
      order: 0;
    }

    .vant-vf__media {
      aspect-ratio: 4 / 3.4;
    }

    .vant-vf__content {
      padding: 32px 24px 36px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vänt image with text",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Cover image"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Or use a product's photo"
    },
    {
      "type": "text",
      "id": "colour",
      "label": "Product colour to show (optional)",
      "info": "e.g. Neutral Sand"
    },
    { "type": "text", "id": "image_label", "label": "Image label", "info": "e.g. Styled room concept" },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Picture fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill the frame (room photos)"
        },
        {
          "value": "contain",
          "label": "Show whole (product photos)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "text",
      "id": "youtube_id",
      "label": "YouTube video ID",
      "info": "Leave empty for no play button.",
      "default": "g2ugde7Zth8"
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "Play button label",
      "default": "Watch the film · 1 min"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "select", "id": "heading_level", "label": "Heading type", "options": [{ "value": "h2", "label": "Section heading" }, { "value": "h1", "label": "Page title (top of the page)" }], "default": "h2" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Fitted in an afternoon"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Padded panels click onto aluminium brackets. No tradesperson needed.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Shop headboard walls"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Red" },
        { "value": "secondary", "label": "Outline" }
      ],
      "default": "primary"
    },
    { "type": "richtext", "id": "note", "label": "Small text under the button" },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "regular", "label": "Regular" },
        { "value": "compact", "label": "Compact (shorter image)" }
      ],
      "default": "regular"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Panel background",
      "default": "#F5F3F1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Vänt video feature"
    }
  ]
}
{% endschema %}
