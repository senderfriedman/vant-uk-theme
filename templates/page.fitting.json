          }
        },
        "b6": {
          "type": "list",
          "settings": {
            "items": "Screwdriver or drill\nSpirit level\nTape measure\nPencil"
          }
        },
        "b7": {
          "type": "heading",
          "settings": {
            "text": "Fitting steps",
            "size": "h2",
            "in_contents": true,
            "anchor": "fitting-steps"
          }
        },
        "b8": {
          "type": "step",
          "settings": {
            "illustration": "plan",
            "title": "Plan your layout",
            "text": "<p>Mark where the bottom row starts: usually just below the top of your mattress, or from the skirting board for a full wall.</p>"
          }
        },
        "b9": {
          "type": "step",
          "settings": {
            "illustration": "brackets",
            "title": "Fix the brackets",
            "text": "<p>Use a spirit level to fit the brackets. No wall plugs are needed on plasterboard. For brick, block or concrete, pre-drill 5mm holes first. Each screw holds up to 22kg.</p>"
          }
        },
        "b10": {
          "type": "step",
          "settings": {
            "illustration": "hook",
            "title": "Hook on the panels",
            "text": "<p>Hook the panels onto the brackets, starting with the bottom row.</p>"
          }
        },
        "b11": {
          "type": "step",
          "settings": {
            "illustration": "trim",
            "title": "Trim brackets if needed",
            "text": "<p>Each bracket holds 2 panels high. For a single row or 3 panels high, trim the bracket to size with a hacksaw.</p>"
          }
        },
        "b12": {
          "type": "heading",
          "settings": {
            "text": "Plug sockets and light switches",
            "size": "h2",
            "in_contents": true,
            "anchor": "plug-sockets"
          }
        },
        "b13": {
          "type": "text",
          "settings": {
            "text": "<p>Mark the opening on the back of the panel. Cut through the wooden base with a jigsaw, then trim the foam and fabric neatly with a sharp craft knife. Keep sockets and switches accessible. If one needs moving, use a qualified electrician.</p>"
          }
        }
      },
